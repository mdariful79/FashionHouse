@model FashionHouse.Domain.Entities.Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">Order @Model.OrderNumber</h5>
                    <small class="text-muted">Placed on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                </div>
                <div class="card-body table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th>Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.SKU</td>
                                    <td>Tk @item.UnitPrice.ToString("N0")</td>
                                    <td>@item.Quantity</td>
                                    <td>Tk @item.LineTotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td colspan="4" class="text-end">Subtotal</td><td>Tk @Model.SubTotal.ToString("N0")</td></tr>
                            <tr><td colspan="4" class="text-end">Shipping</td><td>Tk @Model.ShippingFee.ToString("N0")</td></tr>
                            <tr><td colspan="4" class="text-end">Discount</td><td>- Tk @Model.Discount.ToString("N0")</td></tr>
                            <tr><td colspan="4" class="text-end fw-bold">Grand Total</td><td class="fw-bold">Tk @Model.GrandTotal.ToString("N0")</td></tr>
                        </tfoot>
                    </table>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-3"><strong>Customer note:</strong> @Model.Notes</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header border-bottom"><h5 class="card-title mb-0">Shipping Address</h5></div>
                <div class="card-body">
                    <p class="mb-1 fw-semibold">@Model.ShippingFullName</p>
                    <p class="mb-1">@Model.ShippingEmail</p>
                    <p class="mb-1">@Model.ShippingPhone</p>
                    <p class="mb-0">@Model.ShippingFullAddress, @Model.ShippingDistrict @Model.ShippingPostalCode</p>
                </div>
            </div>

            <div class="card">
                <div class="card-header border-bottom"><h5 class="card-title mb-0">Update Status</h5></div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="Id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">Order Status</label>
                            <select name="Status" class="form-select">
                                @foreach (var status in Enum.GetValues<FashionHouse.Domain.Enums.OrderStatus>())
                                {
                                    <option value="@((int)status)" selected="@(status == Model.Status)">@status</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Payment Status</label>
                            <select name="PaymentStatus" class="form-select">
                                @foreach (var status in Enum.GetValues<FashionHouse.Domain.Enums.PaymentStatus>())
                                {
                                    <option value="@((int)status)" selected="@(status == Model.PaymentStatus)">@status</option>
                                }
                            </select>
                        </div>

                        @if (Model.Status is FashionHouse.Domain.Enums.OrderStatus.Cancelled or FashionHouse.Domain.Enums.OrderStatus.Returned)
                        {
                            <div class="alert alert-info py-2">Stock was already restocked for this order.</div>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2">Setting Cancelled/Returned will restock these items.</div>
                        }

                        <button type="submit" class="btn btn-primary w-100">Save</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>