@model CategoryModel
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row mb-6 gy-6">
        <div class="col-xl">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Edit Category</h5>
                    <small class="text-body float-end">(change)</small>
                </div>
                <div class="card-body">
                    <partial name="_ResponsePartial" />
                    <form asp-area="admin" asp-controller="categories" asp-action="update" asp-antiforgery="true" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-6">
                            <label class="form-label" asp-for="Name">Name</label>
                            <input type="text" class="form-control" asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-6">
                            <label class="form-label" asp-for="Slug">Slug</label>
                            <input type="text" class="form-control" asp-for="Slug" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                        <div class="mb-6">
                            <label class="form-label" asp-for="Description">Description</label>
                            <textarea class="form-control" asp-for="Description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-6">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Active</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Update</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>