@model HomeModel
@{
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";

    // Counts: uncomment the matching line once HomeModel exposes the property.
    // Until then the cards show "—".
    int? categoryCount = null;     // categoryCount = Model.CategoryCount;
    int? subCategoryCount = null;  // subCategoryCount = Model.SubCategoryCount;
    int? productCount = null;      // productCount = Model.ProductCount;
    int? stockCount = null;        // stockCount = Model.StockCount;

    string Show(int? value) => value.HasValue ? value.Value.ToString("N0") : "—";

    // Recent orders
    var recentOrders = Model.RecentOrders;

    string StatusColor(string status) => (status ?? "").Trim().ToLowerInvariant() switch
    {
        "pending" => "secondary",
        "confirmed" => "success",
        "processing" => "warning",
        "shipped" => "info",
        "delivered" or "completed" => "blue",
        "cancelled" or "canceled" or "returned" => "danger",
        _ => "secondary"
    };

    string Initial(string name) =>
        string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim().Substring(0, 1).ToUpperInvariant();
}

<style>
    .fh-dash {
        --c-primary: var(--bs-primary-rgb, 105, 108, 255);
        --c-info: var(--bs-info-rgb, 3, 195, 236);
        --c-success: var(--bs-success-rgb, 113, 221, 55);
        --c-warning: var(--bs-warning-rgb, 255, 171, 0);
        --c-danger: var(--bs-danger-rgb, 255, 62, 29);
        --c-blue: 59, 130, 246;
    }

    /* Custom blue status */
    .bg-label-blue {
        background-color: rgba(var(--c-blue), 0.16) !important;
        color: rgb(var(--c-blue)) !important;
    }

    /* Hero */
    .fh-hero {
        position: relative;
        overflow: hidden;
        padding: 32px 36px;
        border-radius: 20px;
        color: #fff;
        background: radial-gradient( 600px 240px at 90% -20%, rgba(255, 255, 255, .22), transparent 60% ), linear-gradient( 120deg, rgb(var(--c-primary)) 0%, #4a4dd8 55%, #2f31a8 100% );
        box-shadow: 0 18px 40px rgba(var(--c-primary), .28);
    }

        .fh-hero::after {
            content: "";
            position: absolute;
            right: -60px;
            bottom: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .10);
        }

    .fh-hero__date {
        display: inline-block;
        margin-bottom: 10px;
        padding: 4px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .18);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .04em;
    }

    .fh-hero h1 {
        margin: 0 0 6px;
        color: #fff;
        font-size: 28px;
        font-weight: 800;
    }

    .fh-hero p {
        max-width: 560px;
        margin: 0 0 20px;
        color: rgba(255, 255, 255, .85);
        font-size: 15px;
    }

    .fh-hero__actions {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .fh-hero__btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none !important;
        transition: transform .15s ease, background .2s ease, box-shadow .2s ease;
    }

    .fh-hero__btn--solid {
        background: #fff;
        color: #2f31a8 !important;
    }

        .fh-hero__btn--solid:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(0, 0, 0, .2);
        }

    .fh-hero__btn--ghost {
        background: rgba(255, 255, 255, .16);
        color: #fff !important;
        border: 1px solid rgba(255, 255, 255, .35);
    }

        .fh-hero__btn--ghost:hover {
            background: rgba(255, 255, 255, .28);
        }

    /* Section titles */
    .fh-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 30px 0 14px;
    }

        .fh-section-title h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
        }

    /* Stat cards */
    .fh-stat {
        --c: var(--c-primary);
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 22px;
        border-radius: 18px;
        background: var(--bs-card-bg, #fff);
        border: 1px solid var(--bs-border-color, #e7e9ee);
        color: inherit !important;
        text-decoration: none !important;
        overflow: hidden;
        transition: transform .2s ease, box-shadow .25s ease, border-color .2s ease;
    }

        .fh-stat::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: rgb(var(--c));
        }

        .fh-stat:hover {
            transform: translateY(-4px);
            border-color: rgba(var(--c), .5);
            box-shadow: 0 16px 34px rgba(var(--c), .18);
        }

    .fh-stat--primary {
        --c: var(--c-primary);
    }

    .fh-stat--info {
        --c: var(--c-info);
    }

    .fh-stat--success {
        --c: var(--c-success);
    }

    .fh-stat--warning {
        --c: var(--c-warning);
    }

    .fh-stat__top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .fh-stat__label {
        margin: 0 0 6px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--bs-secondary-color, #8a8d93);
    }

    .fh-stat__value {
        margin: 0;
        font-size: 34px;
        font-weight: 800;
        line-height: 1.1;
    }

    .fh-stat__icon {
        flex: none;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: rgba(var(--c), .14);
        color: rgb(var(--c));
        transition: transform .25s ease;
    }

    .fh-stat:hover .fh-stat__icon {
        transform: rotate(-6deg) scale(1.08);
    }

    .fh-stat__icon i {
        font-size: 26px;
    }

    .fh-stat__link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 22px;
        padding-top: 14px;
        border-top: 1px dashed var(--bs-border-color, #e7e9ee);
        font-size: 13px;
        font-weight: 700;
        color: rgb(var(--c));
    }

        .fh-stat__link i {
            font-size: 20px;
            transition: transform .2s ease;
        }

    .fh-stat:hover .fh-stat__link i {
        transform: translateX(4px);
    }

    /* Workflow */
    .fh-flow {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        padding: 22px;
        border-radius: 18px;
        background: var(--bs-card-bg, #fff);
        border: 1px solid var(--bs-border-color, #e7e9ee);
    }

    .fh-flow__step {
        position: relative;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .fh-flow__num {
        flex: none;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(var(--c-primary), .14);
        color: rgb(var(--c-primary));
        font-size: 14px;
        font-weight: 800;
    }

    .fh-flow__step strong {
        display: block;
        font-size: 14px;
    }

    .fh-flow__step span {
        color: var(--bs-secondary-color, #8a8d93);
        font-size: 12.5px;
        line-height: 1.45;
    }

    /* Recent orders */
    .fh-orders {
        border-radius: 18px;
        background: var(--bs-card-bg, #fff);
        border: 1px solid var(--bs-border-color, #e7e9ee);
        overflow: hidden;
    }

    .fh-orders__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--bs-border-color, #e7e9ee);
    }

        .fh-orders__head h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
        }

    .fh-orders__all {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 7px 14px;
        border-radius: 999px;
        background: rgba(var(--c-primary), .12);
        color: rgb(var(--c-primary)) !important;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none !important;
        transition: background .2s ease, color .2s ease;
    }

        .fh-orders__all:hover {
            background: rgb(var(--c-primary));
            color: #fff !important;
        }

    .fh-orders table {
        margin: 0;
    }

    .fh-orders thead th {
        padding: 12px 22px;
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--bs-secondary-color, #8a8d93);
        background: rgba(128, 128, 128, .06);
        border-bottom: 0;
        white-space: nowrap;
    }

    .fh-orders tbody td {
        padding: 14px 22px;
        vertical-align: middle;
        border-color: var(--bs-border-color, #e7e9ee);
    }

    .fh-orders tbody tr {
        transition: background .15s ease;
    }

        .fh-orders tbody tr:hover {
            background: rgba(var(--c-primary), .05);
        }

    .fh-orders__num {
        font-weight: 800;
        color: rgb(var(--c-primary)) !important;
        text-decoration: none !important;
    }

        .fh-orders__num:hover {
            text-decoration: underline !important;
        }

    .fh-cust {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fh-cust__avatar {
        flex: none;
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(var(--c-primary), .14);
        color: rgb(var(--c-primary));
        font-size: 14px;
        font-weight: 800;
    }

    .fh-cust strong {
        display: block;
        font-size: 14px;
    }

    .fh-cust small {
        color: var(--bs-secondary-color, #8a8d93);
        font-size: 12px;
    }

    .fh-orders__total {
        font-weight: 800;
        white-space: nowrap;
    }

    .fh-orders__empty {
        padding: 44px 20px;
        text-align: center;
        color: var(--bs-secondary-color, #8a8d93);
    }

        .fh-orders__empty i {
            display: block;
            margin-bottom: 8px;
            font-size: 40px;
            opacity: .6;
        }

    @@media (max-width: 991px) {
        .fh-flow {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575px) {
        .fh-hero {
            padding: 24px 22px;
        }

            .fh-hero h1 {
                font-size: 22px;
            }

        .fh-flow {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-xxl flex-grow-1 container-p-y fh-dash">

    <!-- Hero -->
    <div class="fh-hero">

        <span class="fh-hero__date">
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </span>

        <h1>@greeting, Admin 👋</h1>

        <p>
            Welcome to Fashion House. Manage your catalog:
            categories, sub categories, products, and stock levels.
        </p>

        <div class="fh-hero__actions">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Index"
               class="fh-hero__btn fh-hero__btn--solid">

                <i class="bx bx-package"></i>
                Manage Products
            </a>

            <a asp-area="Admin"
               asp-controller="Stocks"
               asp-action="Index"
               class="fh-hero__btn fh-hero__btn--ghost">

                <i class="bx bx-archive"></i>
                Check Stock
            </a>

        </div>
    </div>


    <!-- Catalog Overview -->
    <div class="fh-section-title">
        <h5>Catalog overview</h5>
    </div>

    <div class="row g-4">

        <!-- Categories -->
        <div class="col-sm-6 col-xl-3">

            <a asp-area="Admin"
               asp-controller="Categories"
               asp-action="Index"
               class="fh-stat fh-stat--primary">

                <div class="fh-stat__top">

                    <div>
                        <p class="fh-stat__label">Categories</p>
                        <h3 class="fh-stat__value">
                            @Show(categoryCount)
                        </h3>
                    </div>

                    <span class="fh-stat__icon">
                        <i class="bx bx-category"></i>
                    </span>

                </div>

                <div class="fh-stat__link">
                    View Categories
                    <i class="bx bx-right-arrow-alt"></i>
                </div>

            </a>

        </div>


        <!-- Sub Categories -->
        <div class="col-sm-6 col-xl-3">

            <a asp-area="Admin"
               asp-controller="SubCategories"
               asp-action="Index"
               class="fh-stat fh-stat--info">

                <div class="fh-stat__top">

                    <div>
                        <p class="fh-stat__label">Sub Categories</p>

                        <h3 class="fh-stat__value">
                            @Show(subCategoryCount)
                        </h3>
                    </div>

                    <span class="fh-stat__icon">
                        <i class="bx bx-collection"></i>
                    </span>

                </div>

                <div class="fh-stat__link">
                    View Sub Categories
                    <i class="bx bx-right-arrow-alt"></i>
                </div>

            </a>

        </div>


        <!-- Products -->
        <div class="col-sm-6 col-xl-3">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Index"
               class="fh-stat fh-stat--success">

                <div class="fh-stat__top">

                    <div>
                        <p class="fh-stat__label">Products</p>

                        <h3 class="fh-stat__value">
                            @Show(productCount)
                        </h3>
                    </div>

                    <span class="fh-stat__icon">
                        <i class="bx bx-package"></i>
                    </span>

                </div>

                <div class="fh-stat__link">
                    View Products
                    <i class="bx bx-right-arrow-alt"></i>
                </div>

            </a>

        </div>


        <!-- Stock -->
        <div class="col-sm-6 col-xl-3">

            <a asp-area="Admin"
               asp-controller="Stocks"
               asp-action="Index"
               class="fh-stat fh-stat--warning">

                <div class="fh-stat__top">

                    <div>
                        <p class="fh-stat__label">Stock Records</p>

                        <h3 class="fh-stat__value">
                            @Show(stockCount)
                        </h3>
                    </div>

                    <span class="fh-stat__icon">
                        <i class="bx bx-archive"></i>
                    </span>

                </div>

                <div class="fh-stat__link">
                    View Stocks
                    <i class="bx bx-right-arrow-alt"></i>
                </div>

            </a>

        </div>

    </div>


    <!-- Recent Activity -->
    <div class="fh-section-title">
        <h5>Recent activity</h5>
    </div>


    <!-- Recent Orders -->
    <div class="fh-orders">

        <div class="fh-orders__head">

            <h5>Recent orders</h5>

            <a asp-area="Admin"
               asp-controller="Orders"
               asp-action="Index"
               class="fh-orders__all">

                View all
                <i class="bx bx-right-arrow-alt"></i>

            </a>

        </div>


        @if (recentOrders == null || !recentOrders.Any())
        {
            <div class="fh-orders__empty">

                <i class="bx bx-receipt"></i>

                No orders yet.
                New orders will show up here.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table">

                    <thead>

                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th class="d-none d-md-table-cell">Items</th>
                            <th class="d-none d-lg-table-cell">Payment</th>
                            <th class="text-end">Total</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in recentOrders)
                        {
                            <tr>

                                <!-- Order -->
                                <td>

                                    <a asp-area="Admin"
                                       asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="fh-orders__num">

                                        #@order.OrderNumber

                                    </a>

                                </td>


                                <!-- Customer -->
                                <td>

                                    <div class="fh-cust">

                                        <span class="fh-cust__avatar">
                                            @Initial(order.CustomerName)
                                        </span>

                                        <div>

                                            <strong>
                                                @(string.IsNullOrWhiteSpace(order.CustomerName)
                                                    ? "Guest"
                                                    : order.CustomerName)
                                            </strong>

                                            <small>
                                                @order.OrderedAt.ToString(
                                                    "dd MMM yyyy, hh:mm tt")
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- Items -->
                                <td class="d-none d-md-table-cell">
                                    @order.ItemCount
                                </td>


                                <!-- Payment -->
                                <td class="d-none d-lg-table-cell">
                                    @order.PaymentMethod
                                </td>


                                <!-- Total -->
                                <td class="text-end fh-orders__total">
                                    Tk @order.Total.ToString("N0")
                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="badge rounded-pill bg-label-@StatusColor(order.Status)">
                                        @(string.IsNullOrWhiteSpace(order.Status)
                                            ? "—"
                                            : order.Status)
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- Workflow -->
    <div class="fh-section-title">
        <h5>How your catalog fits together</h5>
    </div>


    <div class="fh-flow">

        <div class="fh-flow__step">

            <span class="fh-flow__num">1</span>

            <div>
                <strong>Categories</strong>

                <span>
                    Create the top-level groups,
                    like Men, Women or Shoes.
                </span>
            </div>

        </div>


        <div class="fh-flow__step">

            <span class="fh-flow__num">2</span>

            <div>
                <strong>Sub categories</strong>

                <span>
                    Break each category down
                    into finer sections.
                </span>
            </div>

        </div>


        <div class="fh-flow__step">

            <span class="fh-flow__num">3</span>

            <div>
                <strong>Products</strong>

                <span>
                    Add items with images,
                    prices and descriptions.
                </span>
            </div>

        </div>


        <div class="fh-flow__step">

            <span class="fh-flow__num">4</span>

            <div>
                <strong>Stock</strong>

                <span>
                    Set quantities so customers
                    can add products to their cart.
                </span>
            </div>

        </div>

    </div>

</div>