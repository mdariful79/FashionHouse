@model HomeModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row mb-6 gy-6">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-2">Welcome to Fashion House, Admin 👋</h5>
                    <p class="mb-0">Manage your catalog: categories, sub categories, products, and stock levels.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row gy-6">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1">Categories</p>
                     @*    <h4 class="mb-0">@Model.CategoryCount</h4> *@
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="icon-base bx bx-category icon-lg"></i>
                        </span>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">View Categories</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1">Sub Categories</p>
                      @*   <h4 class="mb-0">@Model.SubCategoryCount</h4> *@
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="icon-base bx bx-collection icon-lg"></i>
                        </span>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-area="Admin" asp-controller="SubCategories" asp-action="Index" class="btn btn-sm btn-outline-info w-100">View Sub Categories</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1">Products</p>
                      @*   <h4 class="mb-0">@Model.ProductCount</h4> *@
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-success">
                            <i class="icon-base bx bx-package icon-lg"></i>
                        </span>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-success w-100">View Products</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1">Stock Records</p>
                       @*  <h4 class="mb-0">@Model.StockCount</h4> *@
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-warning">
                            <i class="icon-base bx bx-archive icon-lg"></i>
                        </span>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-area="Admin" asp-controller="Stocks" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">View Stocks</a>
                </div>
            </div>
        </div>
    </div>
</div>