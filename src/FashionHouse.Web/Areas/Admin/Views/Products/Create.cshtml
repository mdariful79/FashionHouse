@model FashionHouse.Web.Areas.Admin.Models.ProductModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row mb-6 gy-6">
        <div class="col-xl">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Add Product</h5>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        Back to list
                    </a>
                </div>
                <div class="card-body">
                    <partial name="_ResponsePartial" />

                    <form asp-area="Admin" asp-controller="Products" asp-action="Create" asp-antiforgery="true"
                          enctype="multipart/form-data" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label" asp-for="CategoryId">Category</label>
                                <select class="form-select" asp-for="CategoryId" id="categorySelect">
                                    <option value="">-- Select Category --</option>
                                    @foreach (var cat in Model.CategoryOptions)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label" asp-for="SubCategoryId">Sub Category</label>
                                <select class="form-select" asp-for="SubCategoryId" id="subCategorySelect">
                                    <option value="">-- Select Category First --</option>
                                    @foreach (var sub in Model.SubCategoryOptions)
                                    {
                                        <option value="@sub.Id">@sub.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="SubCategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label" asp-for="ProductName">Name</label>
                                <input type="text" class="form-control" asp-for="ProductName" placeholder="Cotton Panjabi" />
                                <span asp-validation-for="ProductName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label" asp-for="SKU">SKU</label>
                                <input type="text" class="form-control" asp-for="SKU" placeholder="PNJ-1001" />
                                <span asp-validation-for="SKU" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label" asp-for="Price">Price</label>
                                <input type="number" step="0.01" class="form-control" asp-for="Price" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label" asp-for="DiscountedPrice">Discounted Price</label>
                                <input type="number" step="0.01" class="form-control" asp-for="DiscountedPrice" />
                                <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <label class="form-label" asp-for="Description">Description</label>
                                <textarea class="form-control" rows="3" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="card mt-2 mb-4">
                            <h5 class="card-header">
                                Product Images
                                <span id="imageCountBadge" class="badge bg-label-secondary ms-2">0 / 3 minimum</span>
                            </h5>
                            <div class="card-body">
                                <div id="imageAlert" class="alert alert-warning d-none">
                                    Add at least 3 images before activating this product.
                                </div>

                                <div id="imageGrid" class="row g-3 mb-3"></div>

                                <input type="file" id="imageUploadInput" name="imageFiles" class="form-control" multiple
                                       accept="image/jpeg,image/jpg,image/png,image/webp" />
                                <small class="text-muted">You can select multiple files at once (jpg, jpeg, png, webp — max 5MB each). Click "Set Primary" on any thumbnail to choose the main image.</small>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            // ---- Cascading Category -> SubCategory dropdown ----
            $('#categorySelect').on('change', function () {
                var categoryId = $(this).val();
                var $subCategory = $('#subCategorySelect');

                if (!categoryId) {
                    $subCategory.empty().append('<option value="">-- Select Category First --</option>');
                    return;
                }

                $subCategory.empty().append('<option value="">Loading...</option>');

                $.getJSON('@Url.Action("GetSubCategoriesByCategory", "Products", new { area = "Admin" })',
                    { categoryId: categoryId },
                    function (data) {
                        $subCategory.empty().append('<option value="">-- Select Sub Category --</option>');
                        $.each(data, function (i, item) {
                            $subCategory.append($('<option>').val(item.id).text(item.name));
                        });
                    });
            });

            // ---- Accumulate + preview selected images before submit ----
            // The FIRST file in this array becomes the primary image server-side
            // (see ProductsController.SaveProductImages: first saved file with no
            // existing primary is marked isPrimary = true). "Set Primary" just
            // reorders this array so the chosen file is at index 0.
            var selectedFiles = [];
            var maxSizeBytes = 5 * 1024 * 1024;

            function renderImagePreview() {
                var $grid = $('#imageGrid').empty();

                selectedFiles.forEach(function (file, idx) {
                    var url = URL.createObjectURL(file);
                    var isPrimary = idx === 0;
                    var $col = $(
                        '<div class="col-3 position-relative" data-idx="' + idx + '">' +
                            '<img class="img-fluid rounded ' + (isPrimary ? 'border border-primary border-3' : '') + '" />' +
                            '<div class="mt-1 d-flex justify-content-between align-items-center">' +
                                (isPrimary
                                    ? '<span class="small text-primary fw-semibold">Primary</span>'
                                    : '<button type="button" class="btn btn-sm btn-outline-primary set-primary-btn">Set Primary</button>') +
                                '<button type="button" class="btn btn-sm btn-outline-danger remove-image-btn">' +
                                    '<i class="bx bx-trash"></i>' +
                                '</button>' +
                            '</div>' +
                        '</div>'
                    );
                    $col.find('img').attr('src', url).one('load', function () {
                        URL.revokeObjectURL(url);
                    });
                    $grid.append($col);
                });

                $('#imageCountBadge').text(selectedFiles.length + ' / 3 minimum');
                $('#imageAlert').toggleClass('d-none', selectedFiles.length >= 3);

                syncFileInput();
            }

            // Rebuild the real <input>'s FileList so the accumulated/reordered
            // files actually post with the form, in the current array order.
            function syncFileInput() {
                var dt = new DataTransfer();
                selectedFiles.forEach(function (file) { dt.items.add(file); });
                $('#imageUploadInput')[0].files = dt.files;
            }

            $('#imageUploadInput').on('change', function () {
                var newFiles = Array.prototype.slice.call(this.files || []);

                newFiles.forEach(function (file) {
                    if (!file.type.startsWith('image/')) return;
                    if (file.size > maxSizeBytes) {
                        alert('"' + file.name + '" exceeds the 5MB size limit and was skipped.');
                        return;
                    }
                    selectedFiles.push(file);
                });

                renderImagePreview();
            });

            $('#imageGrid').on('click', '.remove-image-btn', function () {
                var idx = $(this).closest('[data-idx]').data('idx');
                selectedFiles.splice(idx, 1);
                renderImagePreview();
            });

            $('#imageGrid').on('click', '.set-primary-btn', function () {
                var idx = $(this).closest('[data-idx]').data('idx');
                var chosen = selectedFiles.splice(idx, 1)[0];
                selectedFiles.unshift(chosen);
                renderImagePreview();
            });
        });
    </script>
}