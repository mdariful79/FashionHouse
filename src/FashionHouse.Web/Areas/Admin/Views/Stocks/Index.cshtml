@{
    ViewData["Title"] = "Stocks";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="card-title mb-0">Stock Levels</h5>
                    <div class="d-flex align-items-center gap-3">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="lowStockOnly">
                            <label class="form-check-label" for="lowStockOnly">Low stock only</label>
                        </div>
                        <a asp-area="admin" asp-controller="stocks" asp-action="create" class="btn btn-primary">
                            <i class="bx bx-plus"></i> Add Stock Record
                        </a>
                    </div>
                </div>
                <div class="card-body table-responsive pt-0">
                    <table id="stockTable" class="table table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th>SL</th>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Quantity</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjust-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Adjust Stock</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="adjust-form" action="/admin/stocks/adjust" method="post" asp-antiforgery="true">
                <div class="modal-body">
                    <input type="hidden" id="adjust-product-id" name="ProductId" value="" />

                    <p id="adjust-product-name" class="fw-semibold mb-3"></p>

                    <div class="mb-3">
                        <label class="form-label">Change Quantity</label>
                        <input type="number" class="form-control" name="ChangeQuantity" id="adjust-change-qty" placeholder="e.g. 10 to add, -5 to remove" required />
                        <small class="text-muted">Positive number to add stock, negative to remove stock.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reorder Level</label>
                        <input type="number" class="form-control" name="ReorderLevel" id="adjust-reorder-level" min="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="~/sneat/assets/css/custom-datatables.css">

    <script>
        $(function () {
        var table = $("#stockTable").DataTable({
        processing: true,
        serverSide: true,
        responsive: true,
        autoWidth: true,
        pagingType: "simple_numbers",
        ajax: {
        url: "/Admin/Stocks/GetPagedStocks",
        type: "POST",
        contentType: "application/json",
        dataType: "json",
        data: function (d) {
        d.LowStockOnly = $("#lowStockOnly").is(":checked");
        return JSON.stringify(d);
        }
        },
        columns: [
        {
        data: null,
        orderable: false,
        searchable: false,
        render: function (data, type, row, meta) {
        return meta.row + meta.settings._iDisplayStart + 1;
        }
        },
        { data: 0 }, // Product Name
        { data: 1 }, // SKU
        { data: 2 }, // Quantity
        { data: 3 }, // Reorder Level
        {
        data: 4, // Status
        orderable: false,
        searchable: false,
        render: function (data) {
        return data === 'Low Stock'
        ? '<span class="badge rounded-pill bg-label-danger">Low Stock</span>'
        : '<span class="badge rounded-pill bg-label-success">OK</span>';
        }
        },
        {
        data: null, // ProductId (5) + InventoryId (6)
        orderable: false,
        searchable: false,
        render: function (data, type, row) {
        var productId = row[5];
        var inventoryId = row[6];
        return `
        <button type="button" class="btn btn-sm btn-icon btn-outline-primary show-adjust-modal"
        data-id="${productId}" data-name="${row[0]}" data-reorder="${row[3]}" title="Adjust Stock">
        <i class="bx bx-edit"></i>
        </button>
        <a href="/Admin/Stocks/Update/${inventoryId}" class="btn btn-sm btn-icon btn-outline-secondary" title="Edit Record">
        <i class="bx bx-cog"></i>
        </a>`;
        }
        }
        ]
        });

        $("#lowStockOnly").on('change', function () {
        table.ajax.reload();
        });

        $("#stockTable").on('click', '.show-adjust-modal', function () {
        var id = $(this).data('id');
        var name = $(this).data('name');
        var reorder = $(this).data('reorder');

        $('#adjust-product-id').val(id);
        $('#adjust-product-name').text(name);
        $('#adjust-reorder-level').val(reorder);
        $('#adjust-change-qty').val('');

        $('#adjust-modal').modal('show');
        });
        });
    </script>
}