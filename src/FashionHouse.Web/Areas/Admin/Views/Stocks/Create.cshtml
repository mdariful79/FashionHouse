@model FashionHouse.Web.Areas.Admin.Models.InventoryModel
@{
    ViewData["Title"] = "Add Stock Record";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">Add Stock Record</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Product</label>
                            <select asp-for="ProductId" class="form-select">
                                <option value="">-- Select Product --</option>
                                @foreach (var p in Model.ProductOptions)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Initial Quantity</label>
                            <input asp-for="Quantity" type="number" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Reorder Level</label>
                            <input asp-for="ReorderLevel" type="number" class="form-control" />
                            <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}