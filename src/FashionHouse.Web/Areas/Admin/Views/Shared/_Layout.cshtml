@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] names) =>
        names.Any(n => string.Equals(n, controller, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    var userName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Admin" : User.Identity!.Name!;
    var userInitial = userName.Trim().Substring(0, 1).ToUpperInvariant();
}
<!doctype html>
<html lang="en" class="layout-menu-fixed layout-compact" data-assets-path="~/sneat/assets/" data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Fashion House Admin</title>

    <link rel="icon" type="image/x-icon" href="~/sneat/assets/img/favicon/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/sneat/assets/vendor/fonts/iconify-icons.css" />

    <link rel="stylesheet" href="~/sneat/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/sneat/assets/css/demo.css" />
    <link rel="stylesheet" href="~/sneat/assets/css/admin-theme.css" />

    <link rel="stylesheet" href="~/sneat/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <style>
            /* ---------- Sidebar ---------- */
            .layout-menu .app-brand {
                height: auto;
                padding: 22px 20px 16px;
            }

            .fh-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none !important;
            }

            .fh-brand__mark {
                flex: none;
                display: grid;
                place-items: center;
                width: 42px;
                height: 42px;
                border-radius: 13px;
                color: #fff;
                background: linear-gradient(135deg, rgb(var(--bs-primary-rgb, 105, 108, 255)) 0%, #3f42d8 100%);
                box-shadow: 0 8px 18px rgba(var(--bs-primary-rgb, 105, 108, 255), .38);
            }

                .fh-brand__mark svg {
                    width: 24px;
                    height: 24px;
                }

            .fh-brand__text {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

            .fh-brand__name {
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -.01em;
                color: var(--bs-heading-color, #384551);
            }

            .fh-brand__tag {
                margin-top: 3px;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: .22em;
                text-transform: uppercase;
                color: var(--bs-secondary-color, #8a8d93);
            }

            .layout-menu .menu-header {
                margin: 18px 0 6px;
                padding-left: 22px;
            }

            .layout-menu .menu-header-text {
                font-size: 11px;
                font-weight: 800;
                letter-spacing: .12em;
            }

            .layout-menu .menu-inner > .menu-item {
                margin: 2px 12px;
            }

                .layout-menu .menu-inner > .menu-item > .menu-link {
                    border-radius: 12px;
                    transition: background .2s ease, color .2s ease, transform .15s ease;
                }

                    .layout-menu .menu-inner > .menu-item > .menu-link:hover {
                        background: rgba(var(--bs-primary-rgb, 105, 108, 255), .08);
                        transform: translateX(2px);
                    }

                .layout-menu .menu-inner > .menu-item.active > .menu-link {
                    background: rgba(var(--bs-primary-rgb, 105, 108, 255), .14) !important;
                    color: rgb(var(--bs-primary-rgb, 105, 108, 255)) !important;
                    font-weight: 700;
                    box-shadow: none !important;
                }

                    .layout-menu .menu-inner > .menu-item.active > .menu-link .menu-icon {
                        color: rgb(var(--bs-primary-rgb, 105, 108, 255)) !important;
                    }

                    .layout-menu .menu-inner > .menu-item.active > .menu-link::before {
                        content: "";
                        position: absolute;
                        left: -12px;
                        top: 50%;
                        width: 4px;
                        height: 22px;
                        border-radius: 0 4px 4px 0;
                        background: rgb(var(--bs-primary-rgb, 105, 108, 255));
                        transform: translateY(-50%);
                    }

                .layout-menu .menu-inner > .menu-item > .menu-link {
                    position: relative;
                }

            /* ---------- Navbar ---------- */
            .layout-navbar {
                backdrop-filter: saturate(180%) blur(10px);
                -webkit-backdrop-filter: saturate(180%) blur(10px);
            }

            .fh-page-title {
                line-height: 1.2;
            }

                .fh-page-title small {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: .1em;
                    text-transform: uppercase;
                    color: var(--bs-secondary-color, #8a8d93);
                }

                .fh-page-title h5 {
                    margin: 2px 0 0;
                    font-size: 19px;
                    font-weight: 800;
                }

            .fh-store-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 8px 16px;
                border-radius: 999px;
                border: 1px solid var(--bs-border-color, #e7e9ee);
                background: transparent;
                color: var(--bs-body-color) !important;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none !important;
                transition: background .2s ease, color .2s ease, border-color .2s ease;
            }

                .fh-store-btn:hover {
                    background: rgb(var(--bs-primary-rgb, 105, 108, 255));
                    border-color: rgb(var(--bs-primary-rgb, 105, 108, 255));
                    color: #fff !important;
                }

            .fh-user {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 4px 6px 4px 4px;
                border-radius: 999px;
                transition: background .2s ease;
            }

                .fh-user:hover {
                    background: rgba(var(--bs-primary-rgb, 105, 108, 255), .08);
                }

            .fh-user__avatar {
                position: relative;
                display: grid;
                place-items: center;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, rgb(var(--bs-primary-rgb, 105, 108, 255)), #3f42d8);
                color: #fff;
                font-size: 15px;
                font-weight: 800;
            }

                .fh-user__avatar::after {
                    content: "";
                    position: absolute;
                    right: -1px;
                    bottom: -1px;
                    width: 10px;
                    height: 10px;
                    border-radius: 50%;
                    background: #71dd37;
                    border: 2px solid var(--bs-body-bg, #fff);
                }

            .fh-user__meta {
                line-height: 1.15;
                text-align: left;
            }

                .fh-user__meta strong {
                    display: block;
                    font-size: 13.5px;
                }

                .fh-user__meta small {
                    font-size: 11.5px;
                    color: var(--bs-secondary-color, #8a8d93);
                }

            .fh-dropdown {
                min-width: 240px;
                padding: 8px;
                border: 1px solid var(--bs-border-color, #e7e9ee);
                border-radius: 16px;
                box-shadow: 0 18px 40px rgba(17, 17, 17, .12);
            }

            .fh-dropdown__head {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 12px 12px;
            }

            .fh-dropdown .dropdown-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 12px;
                border-radius: 10px;
                font-size: 14px;
                font-weight: 600;
            }

                .fh-dropdown .dropdown-item.fh-danger {
                    color: #d32f2f;
                }

                    .fh-dropdown .dropdown-item.fh-danger:hover {
                        background: rgba(211, 47, 47, .10);
                    }

            .fh-dropdown form {
                margin: 0;
            }

            /* ---------- Footer ---------- */
            .fh-footer {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                font-size: 13px;
                color: var(--bs-secondary-color, #8a8d93);
            }

                .fh-footer strong {
                    color: var(--bs-body-color);
                }

            @@media (max-width: 575px) {
                .fh-user__meta {
                    display: none;
                }

                .fh-store-btn span {
                    display: none;
                }
            }
    </style>

    <script src="~/sneat/assets/vendor/js/helpers.js"></script>
    <script src="~/sneat/assets/js/config.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="fh-brand">
                        <span class="fh-brand__mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 8.6V8a2.1 2.1 0 1 0-2.1-2.1" />
                                <path d="M12 8.6 3.5 15.3a1.3 1.3 0 0 0 .8 2.3h15.4a1.3 1.3 0 0 0 .8-2.3L12 8.6Z" />
                            </svg>
                        </span>
                        <span class="fh-brand__text">
                            <span class="fh-brand__name">Fashion House</span>
                            <span class="fh-brand__tag">Admin</span>
                        </span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="icon-base bx bx-chevron-left d-block d-xl-none align-middle"></i>
                    </a>
                </div>

                <div class="menu-divider mt-0"></div>
                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    <li class="menu-item @Active("Home")">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-home-smile"></i>
                            <div data-i18n="Dashboard">Dashboard</div>
                        </a>
                    </li>

                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">Catalog</span>
                    </li>
                    <li class="menu-item @Active("Categories")">
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-category"></i>
                            <div data-i18n="Categories">Categories</div>
                        </a>
                    </li>
                    <li class="menu-item @Active("SubCategories")">
                        <a asp-area="Admin" asp-controller="SubCategories" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-collection"></i>
                            <div data-i18n="SubCategories">Sub Categories</div>
                        </a>
                    </li>
                    <li class="menu-item @Active("Products")">
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-package"></i>
                            <div data-i18n="Products">Products</div>
                        </a>
                    </li>
                    <li class="menu-item @Active("Stocks")">
                        <a asp-area="Admin" asp-controller="Stocks" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-archive"></i>
                            <div data-i18n="Stocks">Stocks</div>
                        </a>
                    </li>

                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">Sales</span>
                    </li>
                    <li class="menu-item @Active("Orders")">
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-receipt"></i>
                            <div data-i18n="Orders">Orders</div>
                        </a>
                    </li>
                    <li class="menu-item @Active("Customers")">
                        <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-group"></i>
                            <div data-i18n="Customer">Customers</div>
                        </a>
                    </li>

                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">Other</span>
                    </li>
                    <li class="menu-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base bx bx-arrow-back"></i>
                            <div data-i18n="Site">Back to Site</div>
                        </a>
                    </li>
                </ul>
            </aside>
            <!-- / Menu -->

            <div class="layout-page">
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)" aria-label="Toggle menu">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <div class="navbar-nav align-items-center me-auto">
                            <div class="fh-page-title">
                                <small>Admin</small>
                                <h5>@ViewData["Title"]</h5>
                            </div>
                        </div>

                        <ul class="navbar-nav flex-row align-items-center ms-md-auto gap-3">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Home" asp-action="Index" class="fh-store-btn" target="_blank" rel="noopener">
                                    <i class="icon-base bx bx-store-alt"></i><span>View store</span>
                                </a>
                            </li>

                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow fh-user" href="javascript:void(0);" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="fh-user__avatar">@userInitial</span>
                                    <span class="fh-user__meta d-none d-md-block">
                                        <strong>@userName</strong>
                                        <small>Administrator</small>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end fh-dropdown">
                                    <li>
                                        <div class="fh-dropdown__head">
                                            <span class="fh-user__avatar">@userInitial</span>
                                            <div>
                                                <h6 class="mb-0">@userName</h6>
                                                <small class="text-body-secondary">Fashion House</small>
                                            </div>
                                        </div>
                                    </li>
                                    <li><div class="dropdown-divider my-1"></div></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                            <i class="icon-base bx bx-home-smile"></i> Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                            <i class="icon-base bx bx-arrow-back"></i> Back to site
                                        </a>
                                    </li>
                                    <li><div class="dropdown-divider my-1"></div></li>
                                    <li>
                                        @* Adjust controller/action to match your sign-out endpoint *@
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item fh-danger">
                                                <i class="icon-base bx bx-power-off"></i> Sign out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>

                <div class="content-wrapper">
                    @RenderBody()

                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl">
                            <div class="fh-footer py-4">
                                <div>&#169; @DateTime.Now.Year <strong>Fashion House</strong>. All rights reserved.</div>
                                <div>Admin panel</div>
                            </div>
                        </div>
                    </footer>

                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>

        <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <script src="~/sneat/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/sneat/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/sneat/assets/vendor/js/bootstrap.js"></script>
    <script src="~/sneat/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/sneat/assets/vendor/js/menu.js"></script>
    <script src="~/sneat/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
