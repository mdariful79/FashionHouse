@{
    ViewData["Title"] = "Sub Categories";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="card-title mb-0">Sub Categories</h5>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bx bx-plus"></i> Add Sub Category
            </a>
        </div>

        <div class="table-responsive text-nowrap">
            <partial name="_ModalPartial" />
            <table id="subCategoryTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
        var table = $('#subCategoryTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
        url: '@Url.Action("GetPagedSubCategories", "SubCategories")',
        type: 'POST',
        contentType: 'application/json',
        data: function (d) { return JSON.stringify(d); }
        },
        columns: [
        {
        data: null,
        orderable: false,
        searchable: false,
        render: function (data, type, row, meta) {
        return meta.row + meta.settings._iDisplayStart + 1;
        }
        },
        { data: 0 }, // Name
        { data: 1 }, // Slug
        {
        data: 2, // IsActive
        orderable: false,
        searchable: false,
        render: function (data) {
        return data === 'Active'
        ? '<span class="badge rounded-pill bg-label-success">Active</span>'
        : '<span class="badge rounded-pill bg-label-danger">Inactive</span>';
        }
        },
        {
        data: 3, // Id
        orderable: false,
        searchable: false,
        render: function (id) {
        return `
        <a href="/Admin/SubCategories/Update/${id}" class="btn btn-sm btn-icon btn-outline-primary" title="Edit">
        <i class="bx bx-edit"></i>
        </a>
        <button type="button" class="btn btn-sm btn-icon btn-outline-danger btn-delete" data-id="${id}" title="Delete">
        <i class="bx bx-trash"></i>
        </button>`;
        }
        }
        ]
        });

        $('#subCategoryTable').on('click', '.btn-delete', function () {
        let id = $(this).data('id');
        let deleteModal = $("#delete-modal");
        deleteModal.find('#modelLabel').text("Delete Sub Category");
        deleteModal.find('.modal-body p').html('Are you sure you want to delete this sub category?');
        $('#delete-id').val(id);
        $('#delete-form').attr('action', '/admin/subcategories/delete');
        deleteModal.modal('show');
        });
        });
        $('#delete-btn').on('click', function () {
        $('#delete-form').submit();
        });
    </script>
}