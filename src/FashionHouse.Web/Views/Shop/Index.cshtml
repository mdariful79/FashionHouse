@using FashionHouse.Domain.Enums
@model FashionHouse.Web.Models.Shop.ShopIndexModel
@{
    ViewData["Title"] = "Shop";

    var swatches = new Dictionary<ProductColor, string>
    {
        [ProductColor.Black] = "#111111",
        [ProductColor.White] = "#ffffff",
        [ProductColor.Red] = "#e53935",
        [ProductColor.Blue] = "#1e88e5",
        [ProductColor.Green] = "#43a047",
        [ProductColor.Yellow] = "#fdd835",
        [ProductColor.Gray] = "#9e9e9e",
        [ProductColor.Brown] = "#795548",
        [ProductColor.Pink] = "#ec407a",
        [ProductColor.Purple] = "#8e24aa",
        [ProductColor.Orange] = "#fb8c00",
        [ProductColor.Navy] = "#1a237e",
        [ProductColor.Beige] = "#d9c3a0",
        [ProductColor.Maroon] = "#800000"
    };
    var priceRanges = new List<(string Label, decimal? Min, decimal? Max)>
    {
        ("Tk 0 - 1,000", 0m, 1000m),
        ("Tk 1,000 - 3,000", 1000m, 3000m),
        ("Tk 3,000 - 5,000", 3000m, 5000m),
        ("Tk 5,000 - 10,000", 5000m, 10000m),
        ("Tk 10,000+", 10000m, null)
    };
    string FilterUrl(Guid? cat, Guid? sub, ProductColor? col, ProductSize? sz)
        => Url.Action("Index", "Shop", new
        {
            categoryId = cat,
            subCategoryId = sub,
            color = col,
            size = sz,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sort = Model.Sort
        })!;

    string PriceUrl(decimal? min, decimal? max)
        => Url.Action("Index", "Shop", new
        {
            categoryId = Model.CategoryId,
            subCategoryId = Model.SubCategoryId,
            color = Model.Color,
            size = Model.Size,
            minPrice = min,
            maxPrice = max,
            sort = Model.Sort
        })!;

    string SortUrl(string? sortBy)
        => Url.Action("Index", "Shop", new
        {
            categoryId = Model.CategoryId,
            subCategoryId = Model.SubCategoryId,
            color = Model.Color,
            size = Model.Size,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sort = sortBy
        })!;

    var hasFilter = Model.CategoryId.HasValue || Model.SubCategoryId.HasValue || Model.Color.HasValue
                    || Model.Size.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue
                    || !string.IsNullOrEmpty(Model.Sort);
}
<style>
    .product__item .fh-namecart {
        display: block !important;
        min-height: 22px;
        margin: 0 0 8px 0 !important;
    }

        .product__item .fh-namecart .fh-name {
            display: block !important;
            position: static !important;
            opacity: 1 !important;
            visibility: visible !important;
            transform: none !important;
            color: #111111 !important;
            font-size: 15px;
            font-weight: 600;
            line-height: 22px;
            text-decoration: none;
        }

        .product__item .fh-namecart .fh-cart {
            display: none !important;
            margin: 0 !important;
        }

        .product__item .fh-namecart .fh-cart-btn {
            position: static !important;
            opacity: 1 !important;
            background: none;
            border: 0;
            padding: 0;
            font-size: 15px;
            font-weight: 700;
            line-height: 22px;
            color: #e53637 !important;
            cursor: pointer;
        }

    /* Hover: swap name for Add To Cart */
    .product__item:hover .fh-namecart .fh-name {
        display: none !important;
    }

    .product__item:hover .fh-namecart .fh-cart {
        display: block !important;
    }

    .product__item__pic {
        position: relative;
    }

        .product__item__pic .fh-pic-link {
            position: absolute;
            inset: 0;
            z-index: 1;
            cursor: pointer;
        }

        .product__item__pic .product__hover {
            position: relative;
            z-index: 2;
        }

    /* Touch devices have no hover: show both */
    @@media (hover: none) {
        .product__item:hover .fh-namecart .fh-name,
        .product__item .fh-namecart .fh-name {
            display: block !important;
        }

        .product__item .fh-namecart .fh-cart,
        .product__item:hover .fh-namecart .fh-cart {
            display: block !important;
            margin-top: 4px !important;
        }
    }

    /* ---------- Sidebar filters ---------- */
    .shop__sidebar__categories a.fh-active,
    .shop__sidebar__brand a.fh-active {
        color: #111;
        font-weight: 700;
    }

    .shop__sidebar__price a.fh-active {
        color: #111;
        font-weight: 700;
    }

    /* the "Default" placeholder in the sort dropdown should not be pickable */
    .shop__product__option__right .nice-select .option.disabled {
        display: none;
    }

    .fh-clear-filters {
        color: #e53637;
        font-size: 13px;
        font-weight: 600;
    }

    .fh-filter-sizes {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .fh-filter-sizes a {
            min-width: 38px;
            padding: 6px 10px;
            text-align: center;
            font-size: 13px;
            text-transform: uppercase;
            color: #111;
            border: 1px solid #e1e1e1;
            background: #fff;
        }

            .fh-filter-sizes a:hover {
                border-color: #111;
            }

            .fh-filter-sizes a.active {
                background: #111;
                color: #fff;
                border-color: #111;
            }

    .fh-filter-colors {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

        .fh-filter-colors a {
            display: block;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 1px solid rgba(128, 128, 128, .45);
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .fh-filter-colors a:hover {
                transform: scale(1.08);
            }

            .fh-filter-colors a.active {
                box-shadow: 0 0 0 2px #fff, 0 0 0 4px #111;
            }
</style>

<!-- Shop Section Begin -->
<section class="shop spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="shop__sidebar">
                    <div class="shop__sidebar__search">
                        <form action="#">
                            <input type="text" placeholder="Search...">
                            <button type="submit"><span class="icon_search"></span></button>
                        </form>
                    </div>
                    <div class="shop__sidebar__accordion">
                        <div class="accordion" id="accordionExample">

                            @if (hasFilter)
                            {
                                <div class="mb-3">
                                    <a asp-controller="Shop" asp-action="Index" class="fh-clear-filters">✕ Clear all filters</a>
                                </div>
                            }

                            <!-- Categories -->
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseOne">Categories</a>
                                </div>
                                <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__categories">
                                            <ul class="nice-scroll">
                                                @foreach (var c in Model.Categories)
                                                {
                                                    var isActive = Model.CategoryId == c.Id;
                                                    <li>
                                                        <a class="@(isActive ? "fh-active" : "")"
                                                           href="@FilterUrl(isActive ? null : c.Id, null, Model.Color, Model.Size)">
                                                            @c.Name (@c.Count)
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Branding (SubCategory) -->
                            @if (Model.SubCategories.Any())
                            {
                                <div class="card">
                                    <div class="card-heading">
                                        <a data-toggle="collapse" data-target="#collapseTwo">Branding</a>
                                    </div>
                                    <div id="collapseTwo" class="collapse show" data-parent="#accordionExample">
                                        <div class="card-body">
                                            <div class="shop__sidebar__brand">
                                                <ul>
                                                    @foreach (var s in Model.SubCategories)
                                                    {
                                                        var isActive = Model.SubCategoryId == s.Id;
                                                        <li>
                                                            <a class="@(isActive ? "fh-active" : "")"
                                                               href="@FilterUrl(Model.CategoryId, isActive ? null : s.Id, Model.Color, Model.Size)">
                                                                @s.Name (@s.Count)
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Filter Price (static) -->
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseThree">Filter Price</a>
                                </div>
                                <div id="collapseThree" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__price">
                                            <ul>
                                                @foreach (var r in priceRanges)
                                                {
                                                    var isActive = Model.MinPrice == r.Min && Model.MaxPrice == r.Max;
                                                    <li>
                                                        <a class="@(isActive ? "fh-active" : "")"
                                                           href="@(isActive ? PriceUrl(null, null) : PriceUrl(r.Min, r.Max))">@r.Label</a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Size -->
                            @if (Model.AvailableSizes.Any())
                            {
                                <div class="card">
                                    <div class="card-heading">
                                        <a data-toggle="collapse" data-target="#collapseFour">Size</a>
                                    </div>
                                    <div id="collapseFour" class="collapse show" data-parent="#accordionExample">
                                        <div class="card-body">
                                            <div class="fh-filter-sizes">
                                                @foreach (var sz in Model.AvailableSizes)
                                                {
                                                    var isActive = Model.Size == sz;
                                                    <a class="@(isActive ? "active" : "")"
                                                       href="@FilterUrl(Model.CategoryId, Model.SubCategoryId, Model.Color, isActive ? null : sz)">@sz</a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Colors -->
                            @if (Model.AvailableColors.Any())
                            {
                                <div class="card">
                                    <div class="card-heading">
                                        <a data-toggle="collapse" data-target="#collapseFive">Colors</a>
                                    </div>
                                    <div id="collapseFive" class="collapse show" data-parent="#accordionExample">
                                        <div class="card-body">
                                            <div class="fh-filter-colors">
                                                @foreach (var col in Model.AvailableColors)
                                                {
                                                    var isActive = Model.Color == col;
                                                    <a class="@(isActive ? "active" : "")" title="@col"
                                                       style="background:@swatches[col]"
                                                       href="@FilterUrl(Model.CategoryId, Model.SubCategoryId, isActive ? null : col, Model.Size)"></a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Tags (static) -->
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseSix">Tags</a>
                                </div>
                                <div id="collapseSix" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__tags">
                                            <a href="#">Product</a>
                                            <a href="#">Bags</a>
                                            <a href="#">Shoes</a>
                                            <a href="#">Fashion</a>
                                            <a href="#">Clothing</a>
                                            <a href="#">Hats</a>
                                            <a href="#">Accessories</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="shop__product__option">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__left">
                                @if (Model.TotalItems > 0)
                                {
                                    <p>Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems results</p>
                                }
                                else
                                {
                                    <p>No results found</p>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__right">
                                <p>Sort by Price:</p>
                                <select id="fhSort">
                                    @if (string.IsNullOrEmpty(Model.Sort))
                                    {
                                        <option value="" selected disabled>Default</option>
                                    }
                                    <option value="@SortUrl("price_asc")" selected="@(Model.Sort == "price_asc")">Low To High</option>
                                    <option value="@SortUrl("price_desc")" selected="@(Model.Sort == "price_desc")">High To Low</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    @if (!Model.Products.Any())
                    {
                        <div class="col-lg-12">
                            <p>No products found.</p>
                        </div>
                    }
                    @foreach (var p in Model.Products)
                    {
                        var primaryImage = p.ProductImages.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder).FirstOrDefault();
                        var onSale = p.DiscountedPrice.HasValue && p.DiscountedPrice < p.Price;
                        var newProduct = p.CreatedAt >= DateTime.UtcNow.AddDays(-7);

                        <div class="col-lg-4 col-md-6 col-sm-6">
                            <div class="product__item @(onSale ? "sale" : "")">
                                <div class="product__item__pic set-bg"
                                     data-setbg="@(primaryImage != null ? Url.Content($"~/uploads/products/{primaryImage.ImageUrl}") : Url.Content("~/FrontLayout/img/product/product-2.jpg"))">
                                    <a class="fh-pic-link" asp-action="ShopDetails" asp-route-id="@p.Id" aria-label="View @p.ProductName"></a>
                                    @if (onSale)
                                    {
                                        <span class="label">Sale</span>
                                    }
                                    @if (!onSale && newProduct)
                                    {
                                        <span class="label" style="background: #FF5E0E">New Arraival</span>
                                    }
                                </div>
                                <div class="product__item__text">
                                    <div class="fh-namecart">
                                        <a class="fh-name" asp-action="ShopDetails" asp-route-id="@p.Id">@(string.IsNullOrWhiteSpace(p.ProductName) ? "(No name)" : p.ProductName)</a>

                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="fh-cart">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="fh-cart-btn">+ Add To Cart</button>
                                        </form>
                                    </div>

                                    <div class="rating">
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                    </div>

                                    @if (onSale)
                                    {
                                        <h5>
                                            Tk @p.DiscountedPrice!.Value.ToString("N0")
                                            <span style="text-decoration:line-through; opacity:.5; margin-left:6px;">Tk @p.Price.ToString("N0")</span>
                                        </h5>
                                    }
                                    else
                                    {
                                        <h5>Tk @p.Price.ToString("N0")</h5>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="product__pagination">
                                @for (var i = 1; i <= Model.TotalPages; i++)
                                {
                                    <a class="@(i == Model.CurrentPage ? "active" : "")"
                                       href="@Url.Action("Index", "Shop", new { page = i, categoryId = Model.CategoryId, subCategoryId = Model.SubCategoryId, color = Model.Color, size = Model.Size, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sort = Model.Sort })">@i</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
<!-- Shop Section End -->
@section Scripts {
    <script>
        $(function () {
            $('#fhSort').on('change', function () {
                if (this.value) {
                    window.location.href = this.value;
                }
            });
        });
    </script>
}