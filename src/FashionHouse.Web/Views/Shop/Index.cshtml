@model FashionHouse.Web.Models.Shop.ShopIndexModel
@{
    ViewData["Title"] = "Shop";
}
<style>
    .product__item .fh-namecart {
        display: block !important;
        min-height: 22px;
        margin: 0 0 8px 0 !important;
    }

        .product__item .fh-namecart .fh-name {
            display: block !important;
            position: static !important;
            opacity: 1 !important;
            visibility: visible !important;
            transform: none !important;
            color: #111111 !important;
            font-size: 15px;
            font-weight: 600;
            line-height: 22px;
            text-decoration: none;
        }

        .product__item .fh-namecart .fh-cart {
            display: none !important;
            margin: 0 !important;
        }

        .product__item .fh-namecart .fh-cart-btn {
            position: static !important;
            opacity: 1 !important;
            background: none;
            border: 0;
            padding: 0;
            font-size: 15px;
            font-weight: 700;
            line-height: 22px;
            color: #e53637 !important;
            cursor: pointer;
        }

    /* Hover: swap name for Add To Cart */
    .product__item:hover .fh-namecart .fh-name {
        display: none !important;
    }

    .product__item:hover .fh-namecart .fh-cart {
        display: block !important;
    }

    /* Touch devices have no hover: show both */
    @@media (hover: none) {
        .product__item:hover .fh-namecart .fh-name,
        .product__item .fh-namecart .fh-name {
            display: block !important;
        }

        .product__item .fh-namecart .fh-cart,
        .product__item:hover .fh-namecart .fh-cart {
            display: block !important;
            margin-top: 4px !important;
        }
    }
</style>
<!-- Shop Section Begin -->
<section class="shop spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="shop__sidebar">
                    <div class="shop__sidebar__search">
                        <form action="#">
                            <input type="text" placeholder="Search...">
                            <button type="submit"><span class="icon_search"></span></button>
                        </form>
                    </div>
                    <div class="shop__sidebar__accordion">
                        <div class="accordion" id="accordionExample">
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseOne">Categories</a>
                                </div>
                                <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__categories">
                                            <ul class="nice-scroll">
                                                <li><a href="#">Men (20)</a></li>
                                                <li><a href="#">Women (20)</a></li>
                                                <li><a href="#">Bags (20)</a></li>
                                                <li><a href="#">Clothing (20)</a></li>
                                                <li><a href="#">Shoes (20)</a></li>
                                                <li><a href="#">Accessories (20)</a></li>
                                                <li><a href="#">Kids (20)</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseTwo">Branding</a>
                                </div>
                                <div id="collapseTwo" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__brand">
                                            <ul>
                                                <li><a href="#">Louis Vuitton</a></li>
                                                <li><a href="#">Chanel</a></li>
                                                <li><a href="#">Hermes</a></li>
                                                <li><a href="#">Gucci</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseThree">Filter Price</a>
                                </div>
                                <div id="collapseThree" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__price">
                                            <ul>
                                                <li><a href="#">$0.00 - $50.00</a></li>
                                                <li><a href="#">$50.00 - $100.00</a></li>
                                                <li><a href="#">$100.00 - $150.00</a></li>
                                                <li><a href="#">$150.00 - $200.00</a></li>
                                                <li><a href="#">$200.00 - $250.00</a></li>
                                                <li><a href="#">250.00+</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseFour">Size</a>
                                </div>
                                <div id="collapseFour" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__size">
                                            <label for="xs">xs<input type="radio" id="xs"></label>
                                            <label for="sm">s<input type="radio" id="sm"></label>
                                            <label for="md">m<input type="radio" id="md"></label>
                                            <label for="xl">xl<input type="radio" id="xl"></label>
                                            <label for="2xl">2xl<input type="radio" id="2xl"></label>
                                            <label for="xxl">xxl<input type="radio" id="xxl"></label>
                                            <label for="3xl">3xl<input type="radio" id="3xl"></label>
                                            <label for="4xl">4xl<input type="radio" id="4xl"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseFive">Colors</a>
                                </div>
                                <div id="collapseFive" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__color">
                                            <label class="c-1" for="sp-1"><input type="radio" id="sp-1"></label>
                                            <label class="c-2" for="sp-2"><input type="radio" id="sp-2"></label>
                                            <label class="c-3" for="sp-3"><input type="radio" id="sp-3"></label>
                                            <label class="c-4" for="sp-4"><input type="radio" id="sp-4"></label>
                                            <label class="c-5" for="sp-5"><input type="radio" id="sp-5"></label>
                                            <label class="c-6" for="sp-6"><input type="radio" id="sp-6"></label>
                                            <label class="c-7" for="sp-7"><input type="radio" id="sp-7"></label>
                                            <label class="c-8" for="sp-8"><input type="radio" id="sp-8"></label>
                                            <label class="c-9" for="sp-9"><input type="radio" id="sp-9"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-heading">
                                    <a data-toggle="collapse" data-target="#collapseSix">Tags</a>
                                </div>
                                <div id="collapseSix" class="collapse show" data-parent="#accordionExample">
                                    <div class="card-body">
                                        <div class="shop__sidebar__tags">
                                            <a href="#">Product</a>
                                            <a href="#">Bags</a>
                                            <a href="#">Shoes</a>
                                            <a href="#">Fashion</a>
                                            <a href="#">Clothing</a>
                                            <a href="#">Hats</a>
                                            <a href="#">Accessories</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="shop__product__option">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__left">
                                @if (Model.TotalItems > 0)
                                {
                                    <p>Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems results</p>
                                }
                                else
                                {
                                    <p>No results found</p>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__right">
                                <p>Sort by Price:</p>
                                <select>
                                    <option value="">Low To High</option>
                                    <option value="">$0 - $55</option>
                                    <option value="">$55 - $100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    @if (!Model.Products.Any())
                    {
                        <div class="col-lg-12">
                            <p>No products found.</p>
                        </div>
                    }
                    @foreach (var p in Model.Products)
                    {
                        var primaryImage = p.ProductImages.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder).FirstOrDefault();
                        var onSale = p.DiscountedPrice.HasValue && p.DiscountedPrice < p.Price;

                        <div class="col-lg-4 col-md-6 col-sm-6">
                            <div class="product__item @(onSale ? "sale" : "")">
                                <div class="product__item__pic set-bg"
                                     data-setbg="@(primaryImage != null ? Url.Content($"~/uploads/products/{primaryImage.ImageUrl}") : Url.Content("~/FrontLayout/img/product/product-2.jpg"))">
                                    @if (onSale)
                                    {
                                        <span class="label">Sale</span>
                                    }
                                    <ul class="product__hover">
                                        <li><a href="#"><img src="~/FrontLayout/img/icon/heart.png" alt=""></a></li>
                                        <li><a href="#"><img src="~/FrontLayout/img/icon/compare.png" alt=""> <span>Compare</span></a></li>
                                        <li><a asp-action="ShopDetails" asp-route-id="@p.Id"><img src="~/FrontLayout/img/icon/search.png" alt=""></a></li>
                                    </ul>
                                </div>
                                <div class="product__item__text">
                                    <div class="fh-namecart">
                                        <a class="fh-name" asp-action="ShopDetails" asp-route-id="@p.Id">@(string.IsNullOrWhiteSpace(p.ProductName) ? "(No name)" : p.ProductName)</a>

                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="fh-cart">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="fh-cart-btn">+ Add To Cart</button>
                                        </form>
                                    </div>

                                    <div class="rating">
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                    </div>

                                    @if (onSale)
                                    {
                                        <h5>
                                            Tk @p.DiscountedPrice!.Value.ToString("N0")
                                            <span style="text-decoration:line-through; opacity:.5; margin-left:6px;">Tk @p.Price.ToString("N0")</span>
                                        </h5>
                                    }
                                    else
                                    {
                                        <h5>Tk @p.Price.ToString("N0")</h5>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="product__pagination">
                                @for (var i = 1; i <= Model.TotalPages; i++)
                                {
                                    <a class="@(i == Model.CurrentPage ? "active" : "")" asp-action="Index" asp-route-page="@i">@i</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
<!-- Shop Section End -->
