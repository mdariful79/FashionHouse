@model FashionHouse.Web.Models.Shop.ShopDetailsModel
@{
    ViewData["Title"] = Model.Product.ProductName;
    var images = Model.Product.ProductImages.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder).ToList();
    var onSale = Model.Product.DiscountedPrice.HasValue && Model.Product.DiscountedPrice < Model.Product.Price;
}

<!-- Shop Details Section Begin -->
<section class="shop-details">
    <div class="product__details__pic">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="product__details__breadcrumb">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Shop" asp-action="Index">Shop</a>
                        <span>@Model.Product.ProductName</span>
                    </div>
                </div>
            </div>
            <div class="row">
                @if (images.Any())
                {
                    <div class="col-lg-3 col-md-3">
                        <ul class="nav nav-tabs" role="tablist">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(i == 0 ? "active" : "")" data-toggle="tab" href="#tabs-@(i + 1)" role="tab">
                                        <div class="product__thumb__pic set-bg" data-setbg="@Url.Content($"~/uploads/products/{images[i].ImageUrl}")"></div>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-lg-6 col-md-9">
                        <div class="tab-content">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <div class="tab-pane @(i == 0 ? "active" : "")" id="tabs-@(i + 1)" role="tabpanel">
                                    <div class="product__details__pic__item">
                                        <img src="~/uploads/products/@images[i].ImageUrl" alt="@Model.Product.ProductName">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-lg-9 offset-lg-3">
                        <div class="product__details__pic__item">
                            <img src="~/FrontLayout/img/product/product-2.jpg" alt="@Model.Product.ProductName">
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="product__details__content">
        <div class="container">
            <div class="row d-flex justify-content-center">
                <div class="col-lg-8">
                    <div class="product__details__text">
                        <h4>@Model.Product.ProductName</h4>

                        @if (onSale)
                        {
                            <h3>
                                Tk @Model.Product.DiscountedPrice!.Value.ToString("N0")
                                <span style="text-decoration:line-through; opacity:.5; font-size:.7em; margin-left:8px;">Tk @Model.Product.Price.ToString("N0")</span>
                            </h3>
                        }
                        else
                        {
                            <h3>Tk @Model.Product.Price.ToString("N0")</h3>
                        }

                        <p>@Model.Product.Description</p>

                        @if (Model.AvailableStock > 0)
                        {
                            <p class="text-success">In stock (@Model.AvailableStock available)</p>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.Product.Id" />
                                <div class="product__details__cart__option">
                                    <div class="quantity">
                                        <div class="pro-qty">
                                            <input type="number" name="quantity" value="1" min="1" max="@Model.AvailableStock">
                                        </div>
                                    </div>
                                    <button type="submit" class="primary-btn">Add to Cart</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <p class="text-danger">Out of stock</p>
                        }

                        <div class="product__details__last__option">
                            <ul>
                                <li><span>SKU:</span> @Model.Product.SKU</li>
                                <li><span>Category:</span> @Model.Product.Category?.Name</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Shop Details Section End -->
@if (Model.RelatedProducts.Any())
{
    <!-- Related Section Begin -->
    <section class="related spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <h3 class="related-title">Related Products</h3>
                </div>
            </div>
            <div class="row">
                @foreach (var p in Model.RelatedProducts)
                {
                    var primaryImage = p.ProductImages.OrderByDescending(x => x.IsPrimary).FirstOrDefault();
                    var pOnSale = p.DiscountedPrice.HasValue && p.DiscountedPrice < p.Price;

                    <div class="col-lg-3 col-md-6 col-sm-6">
                        <div class="product__item @(pOnSale ? "sale" : "")">
                            <div class="product__item__pic set-bg"
                                 data-setbg="@(primaryImage != null ? Url.Content($"~/uploads/products/{primaryImage.ImageUrl}") : Url.Content("~/FrontLayout/img/product/product-2.jpg"))">
                                @if (pOnSale)
                                {
                                    <span class="label">Sale</span>
                                }
                                <ul class="product__hover">
                                    <li><a href="#"><img src="~/FrontLayout/img/icon/heart.png" alt=""></a></li>
                                    <li><a href="#"><img src="~/FrontLayout/img/icon/compare.png" alt=""> <span>Compare</span></a></li>
                                    <li><a asp-action="ShopDetails" asp-route-id="@p.Id"><img src="~/FrontLayout/img/icon/search.png" alt=""></a></li>
                                </ul>
                            </div>
                            <div class="product__item__text">
                                <h6><a asp-action="ShopDetails" asp-route-id="@p.Id">@p.ProductName</a></h6>

                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="add-cart">+ Add To Cart</button>
                                </form>

                                @if (pOnSale)
                                {
                                    <h5>Tk @p.DiscountedPrice!.Value.ToString("N0")</h5>
                                }
                                else
                                {
                                    <h5>Tk @p.Price.ToString("N0")</h5>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- Related Section End -->
}