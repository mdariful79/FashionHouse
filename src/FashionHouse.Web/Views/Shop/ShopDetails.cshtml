<!-- Shop Details Section End -->
@if (Model.RelatedProducts.Any())
{
    <style>
        .product__item .fh-namecart {
            display: block !important;
            min-height: 22px;
            margin: 0 0 8px 0 !important;
        }

            .product__item .fh-namecart .fh-name {
                display: block !important;
                position: static !important;
                opacity: 1 !important;
                visibility: visible !important;
                transform: none !important;
                color: #111111 !important;
                font-size: 15px;
                font-weight: 600;
                line-height: 22px;
                text-decoration: none;
            }

            .product__item .fh-namecart .fh-cart {
                display: none !important;
                margin: 0 !important;
            }

            .product__item .fh-namecart .fh-cart-btn {
                position: static !important;
                opacity: 1 !important;
                background: none;
                border: 0;
                padding: 0;
                font-size: 15px;
                font-weight: 700;
                line-height: 22px;
                color: #e53637 !important;
                cursor: pointer;
            }

        /* Hover: swap name for Add To Cart */
        .product__item:hover .fh-namecart .fh-name {
            display: none !important;
        }

        .product__item:hover .fh-namecart .fh-cart {
            display: block !important;
        }

        .product__item__pic {
            position: relative;
        }

            .product__item__pic .fh-pic-link {
                position: absolute;
                inset: 0;
                z-index: 1;
                cursor: pointer;
            }

        /* Touch devices have no hover: show both */
        @@media (hover: none) {
            .product__item:hover .fh-namecart .fh-name,
            .product__item .fh-namecart .fh-name {
                display: block !important;
            }

            .product__item .fh-namecart .fh-cart,
            .product__item:hover .fh-namecart .fh-cart {
                display: block !important;
                margin-top: 4px !important;
            }
        }
    </style>

    <!-- Related Section Begin -->
    <section class="related spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <h3 class="related-title">Related Product</h3>
                </div>
            </div>
            <div class="row">
                @foreach (var p in Model.RelatedProducts)
                {
                    var primaryImage = p.ProductImages.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder).FirstOrDefault();
                    var pOnSale = p.DiscountedPrice.HasValue && p.DiscountedPrice < p.Price;
                    var pIsNew = p.CreatedAt >= DateTime.UtcNow.AddDays(-7);

                    <div class="col-lg-3 col-md-6 col-sm-6">
                        <div class="product__item @(pOnSale ? "sale" : "")">
                            <div class="product__item__pic set-bg"
                                 data-setbg="@(primaryImage != null ? Url.Content($"~/uploads/products/{primaryImage.ImageUrl}") : Url.Content("~/FrontLayout/img/product/product-2.jpg"))">
                                <a class="fh-pic-link" asp-controller="Shop" asp-action="ShopDetails" asp-route-id="@p.Id" aria-label="View @p.ProductName"></a>
                                @if (pOnSale)
                                {
                                    <span class="label">Sale</span>
                                }
                                @if (!pOnSale && pIsNew)
                                {
                                    <span class="label" style="background: #FF5E0E">New Arraival</span>
                                }
                            </div>
                            <div class="product__item__text">
                                <div class="fh-namecart">
                                    <a class="fh-name" asp-controller="Shop" asp-action="ShopDetails" asp-route-id="@p.Id">@(string.IsNullOrWhiteSpace(p.ProductName) ? "(No name)" : p.ProductName)</a>

                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="fh-cart">
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="fh-cart-btn">+ Add To Cart</button>
                                    </form>
                                </div>

                                <div class="rating">
                                    <i class="fa fa-star-o"></i>
                                    <i class="fa fa-star-o"></i>
                                    <i class="fa fa-star-o"></i>
                                    <i class="fa fa-star-o"></i>
                                    <i class="fa fa-star-o"></i>
                                </div>

                                @if (pOnSale)
                                {
                                    <h5>
                                        Tk @p.DiscountedPrice!.Value.ToString("N0")
                                        <span style="text-decoration:line-through; opacity:.5; margin-left:6px;">Tk @p.Price.ToString("N0")</span>
                                    </h5>
                                }
                                else
                                {
                                    <h5>Tk @p.Price.ToString("N0")</h5>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- Related Section End -->
}

@section Scripts {
    <script>
        $(function () {
            function clampQty($input) {
                var max = parseInt($input.data('max')) || 9999;
                var val = parseInt($input.val());
                if (isNaN(val) || val < 1) val = 1;
                if (val > max) val = max;
                $input.val(val);
            }

            // template's +/- buttons run first, then we enforce min/max
            $(document).on('click', '.pro-qty .qtybtn', function () {
                clampQty($(this).closest('.pro-qty').find('input'));
            });

            $('.pro-qty input').on('change blur', function () {
                clampQty($(this));
            });

            $('.js-qty-form').on('submit', function () {
                clampQty($(this).find('.pro-qty input'));
            });
        });
    </script>
}
