                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star-o"></i>
                            <span> - 5 Reviews</span>
                        </div>

                        @if (onSale)
                        {
                            <h3>Tk @Model.Product.DiscountedPrice!.Value.ToString("N0") <span>Tk @Model.Product.Price.ToString("N0")</span></h3>
                        }
                        else
                        {
                            <h3>Tk @Model.Product.Price.ToString("N0")</h3>
                        }

                        <p>@Model.Product.Description</p>

                        <div class="product__details__option">
                            <div class="product__details__option__size">
                                <span>Size:</span>
                                <label for="xxl">
                                    xxl
                                    <input type="radio" id="xxl">
                                </label>
                                <label class="active" for="xl">
                                    xl
                                    <input type="radio" id="xl">
                                </label>
                                <label for="l">
                                    l
                                    <input type="radio" id="l">
                                </label>
                                <label for="sm">
                                    s
                                    <input type="radio" id="sm">
                                </label>
                            </div>
                            <div class="product__details__option__color">
                                <span>Color:</span>
                                <label class="c-1" for="sp-1">
                                    <input type="radio" id="sp-1">
                                </label>
                                <label class="c-2" for="sp-2">
                                    <input type="radio" id="sp-2">
                                </label>
                                <label class="c-3" for="sp-3">
                                    <input type="radio" id="sp-3">
                                </label>
                                <label class="c-4" for="sp-4">
                                    <input type="radio" id="sp-4">
                                </label>
                                <label class="c-9" for="sp-9">
                                    <input type="radio" id="sp-9">
                                </label>
                            </div>
                        </div>

                        @if (inStock)
                        {
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="product__details__cart__option js-qty-form">
                                <input type="hidden" name="productId" value="@Model.Product.Id" />
                                <div class="quantity">
                                    <div class="pro-qty">
                                        <input type="text" name="quantity" value="1" data-max="@Model.AvailableStock">
                                    </div>
                                </div>
                                <button type="submit" class="primary-btn" style="border:0;cursor:pointer;">add to cart</button>
                            </form>
                        }
                        else
                        {
                            <div class="product__details__cart__option">
                                <button type="button" class="primary-btn" style="border:0;opacity:.5;cursor:not-allowed;" disabled>out of stock</button>
                            </div>
                        }

                        <div class="product__details__btns__option">
                            <a href="#"><i class="fa fa-heart"></i> add to wishlist</a>
                            <a href="#"><i class="fa fa-exchange"></i> Add To Compare</a>
                        </div>

                        <div class="product__details__last__option">
                            <h5><span>Guaranteed Safe Checkout</span></h5>
                            <img src="~/FrontLayout/img/shop-details/details-payment.png" alt="">
                            <ul>
                                <li><span>SKU:</span> @Model.Product.SKU</li>
                                @if (Model.Product.Category != null)
                                {
                                    <li><span>Categories:</span> @Model.Product.Category.Name</li>
                                }
                                <li><span>Availability:</span> @(inStock ? $"In Stock ({Model.AvailableStock})" : "Out of Stock")</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

