@{
    ViewData["Title"] = "Shop/Shop-Details";
}

<!-- Shop Details Section Begin -->
<section class="shop-details">
    <div class="product__details__pic">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="product__details__breadcrumb">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Shop" asp-action="Index">Shop</a>
                        <span>Product Details</span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 col-md-3">
                    <ul class="nav nav-tabs" role="tablist">
                        @for (int i = 0; i < Model.ThumbnailImages.Count; i++)
                        {
                            var tabId = $"tabs-{i + 1}";
                            var isLast = i == Model.ThumbnailImages.Count - 1;
                            <li class="nav-item">
                                <a class="nav-link @(i == 0 ? "active" : "")" data-toggle="tab" href="#@tabId" role="tab">
                                    <div class="product__thumb__pic set-bg" data-setbg="@Url.Content("~/" + Model.ThumbnailImages[i])">
                                        @if (isLast)
                                        {
                                            <i class="fa fa-play"></i>
                                        }
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-lg-6 col-md-9">
                    <div class="tab-content">
                        @for (int i = 0; i < Model.FullSizeImages.Count; i++)
                        {
                            var tabId = $"tabs-{i + 1}";
                            var isLast = i == Model.FullSizeImages.Count - 1;
                            <div class="tab-pane @(i == 0 ? "active" : "")" id="@tabId" role="tabpanel">
                                <div class="product__details__pic__item">
                                    <img src="~/@Model.FullSizeImages[i]" alt="">
                                    @if (isLast)
                                    {
                                        <a href="@Model.VideoUrl" class="video-popup"><i class="fa fa-play"></i></a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="product__details__content">
        <div class="container">
            <div class="row d-flex justify-content-center">
                <div class="col-lg-8">
                    <div class="product__details__text">
                        <h4>@Model.Name</h4>
                        <div class="rating">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="fa @(i < Model.RatingOutOfFive ? "fa-star" : "fa-star-o")"></i>
                            }
                            <span> - @Model.ReviewCount Reviews</span>
                        </div>
                        <h3>
                            @Model.Price.ToString("C")
                            @if (Model.SalePrice.HasValue)
                            {
                                <span>@Model.SalePrice.Value.ToString("N2")</span>
                            }
                        </h3>
                        <p>@Model.Description</p>
                        <div class="product__details__option">
                            <div class="product__details__option__size">
                                <span>Size:</span>
                                @foreach (var size in Model.Sizes)
                                {
                                    <label class="@(size == Model.SelectedSize ? "active" : "")" for="size-@size">
                                        @size
                                        <input type="radio" id="size-@size" name="size" value="@size" checked="@(size == Model.SelectedSize)">
                                    </label>
                                }
                            </div>
                            <div class="product__details__option__color">
                                <span>Color:</span>
                                @foreach (var colorClass in Model.ColorSwatchClasses)
                                {
                                    <label class="@colorClass" for="color-@colorClass">
                                        <input type="radio" id="color-@colorClass" name="color" value="@colorClass">
                                    </label>
                                }
                            </div>
                        </div>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="sku" value="@Model.Sku" />
                            <div class="product__details__cart__option">
                                <div class="quantity">
                                    <div class="pro-qty">
                                        <input type="text" name="quantity" value="1">
                                    </div>
                                </div>
                                <button type="submit" class="primary-btn">add to cart</button>
                            </div>
                        </form>
                        <div class="product__details__btns__option">
                            <a asp-controller="Wishlist" asp-action="Add" asp-route-sku="@Model.Sku">
                                <i class="fa fa-heart"></i> add to wishlist
                            </a>
                            <a asp-controller="Compare" asp-action="Add" asp-route-sku="@Model.Sku">
                                <i class="fa fa-exchange"></i> Add To Compare
                            </a>
                        </div>
                        <div class="product__details__last__option">
                            <h5><span>Guaranteed Safe Checkout</span></h5>
                            <img src="~/img/shop-details/details-payment.png" alt="">
                            <ul>
                                <li><span>SKU:</span> @Model.Sku</li>
                                <li><span>Categories:</span> @Model.Categories</li>
                                <li><span>Tag:</span> @Model.Tags</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="product__details__tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-toggle="tab" href="#tabs-5" role="tab">Description</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-toggle="tab" href="#tabs-6" role="tab">Customer Previews(@Model.ReviewCount)</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-toggle="tab" href="#tabs-7" role="tab">Additional information</a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane active" id="tabs-5" role="tabpanel">
                                @await Html.PartialAsync("_ProductDescriptionTab")
                            </div>
                            <div class="tab-pane" id="tabs-6" role="tabpanel">
                                @await Html.PartialAsync("_ProductDescriptionTab")
                            </div>
                            <div class="tab-pane" id="tabs-7" role="tabpanel">
                                @await Html.PartialAsync("_ProductDescriptionTab")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Shop Details Section End -->
<!-- Related Section Begin -->
<section class="related spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h3 class="related-title">Related Product</h3>
            </div>
        </div>
        <div class="row">
            @foreach (var product in Model.RelatedProducts)
            {
                <div class="col-lg-3 col-md-6 col-sm-6 col-sm-6">
                    <div class="product__item @(product.IsOnSale ? "sale" : "")">
                        <div class="product__item__pic set-bg" data-setbg="@Url.Content("~/" + product.ImageUrl)">
                            @if (!string.IsNullOrEmpty(product.Label))
                            {
                                <span class="label">@product.Label</span>
                            }
                            <ul class="product__hover">
                                <li><a href="#"><img src="~/img/icon/heart.png" alt=""></a></li>
                                <li><a href="#"><img src="~/img/icon/compare.png" alt=""> <span>Compare</span></a></li>
                                <li><a href="#"><img src="~/img/icon/search.png" alt=""></a></li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6>@product.Name</h6>
                            <a href="#" class="add-cart">+ Add To Cart</a>
                            <div class="rating">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="fa @(i < product.RatingOutOfFive ? "fa-star" : "fa-star-o")"></i>
                                }
                            </div>
                            <h5>@product.Price.ToString("C")</h5>
                            <div class="product__color__select">
                                <label for="pc-@product.Name-1">
                                    <input type="radio" id="pc-@product.Name-1">
                                </label>
                                <label class="active black" for="pc-@product.Name-2">
                                    <input type="radio" id="pc-@product.Name-2">
                                </label>
                                <label class="grey" for="pc-@product.Name-3">
                                    <input type="radio" id="pc-@product.Name-3">
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Related Section End -->
