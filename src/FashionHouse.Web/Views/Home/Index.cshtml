@model FashionHouse.Web.Models.Home.HomeIndexModel
@{
    ViewData["Title"] = "Home";

    // Only tabs that actually have products are shown. The first one is active.
    var tabs = new List<(string Key, string Label, IList<FashionHouse.Domain.Entities.Product> Items)>();
    if (Model.BestSellers.Any()) tabs.Add(("best-sellers", "Best Sellers", Model.BestSellers));
    if (Model.NewArrivals.Any()) tabs.Add(("new-arrivals", "New Arrivals", Model.NewArrivals));
    if (Model.HotSales.Any()) tabs.Add(("hot-sales", "Hot Sales", Model.HotSales));
}

<style>
    .product__item .fh-namecart {
        display: block !important;
        min-height: 22px;
        margin: 0 0 8px 0 !important;
    }

        .product__item .fh-namecart .fh-name {
            display: block !important;
            position: static !important;
            opacity: 1 !important;
            visibility: visible !important;
            transform: none !important;
            color: #111111 !important;
            font-size: 15px;
            font-weight: 600;
            line-height: 22px;
            text-decoration: none;
        }

        .product__item .fh-namecart .fh-cart {
            display: none !important;
            margin: 0 !important;
        }

        .product__item .fh-namecart .fh-cart-btn {
            position: static !important;
            opacity: 1 !important;
            background: none;
            border: 0;
            padding: 0;
            font-size: 15px;
            font-weight: 700;
            line-height: 22px;
            color: #e53637 !important;
            cursor: pointer;
        }

    /* Hover: swap name for Select Options */
    .product__item:hover .fh-namecart .fh-name {
        display: none !important;
    }

    .product__item:hover .fh-namecart .fh-cart {
        display: block !important;
    }

    .product__item__pic {
        position: relative;
    }

        .product__item__pic .fh-pic-link {
            position: absolute;
            inset: 0;
            z-index: 1;
            cursor: pointer;
        }

    /* Touch devices have no hover: show both */
    @@media (hover: none) {
        .product__item:hover .fh-namecart .fh-name,
        .product__item .fh-namecart .fh-name {
            display: block !important;
        }

        .product__item .fh-namecart .fh-cart,
        .product__item:hover .fh-namecart .fh-cart {
            display: block !important;
            margin-top: 4px !important;
        }
    }
</style>

<!-- Hero Section Begin -->
