@section Scripts {
    <script>
        // Show only the first tab on load instead of all three at once
        $(window).on('load', function () {
            setTimeout(function () {
                var first = document.querySelector('.filter__controls li.active');
                if (first) first.click();
            }, 50);
        });
    </script>
}
