            <div class="container">
                <div class="row">
                    <div class="col-xl-5 col-lg-7 col-md-8">
                        <div class="hero__text">
                            <h6>Summer Collection</h6>
                            <h2>Fall - Winter Collections 2030</h2>
                            <p>
                                A specialist label creating luxury essentials. Ethically crafted with an unwavering
                                commitment to exceptional quality.
                            </p>
                            <a asp-controller="Shop" asp-action="Index" class="primary-btn">Shop now <span class="arrow_right"></span></a>
                            <div class="hero__social">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero__items set-bg" data-setbg="@Url.Content("~/FrontLayout/img/hero/hero-2.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-xl-5 col-lg-7 col-md-8">
                        <div class="hero__text">
                            <h6>Summer Collection</h6>
                            <h2>Fall - Winter Collections 2030</h2>
                            <p>
                                A specialist label creating luxury essentials. Ethically crafted with an unwavering
                                commitment to exceptional quality.
                            </p>
                            <a asp-controller="Shop" asp-action="Index" class="primary-btn">Shop now <span class="arrow_right"></span></a>
                            <div class="hero__social">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->
<!-- Banner Section Begin -->
<section class="banner spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 offset-lg-4">
                <div class="banner__item">
                    <div class="banner__item__pic">
                        <img src="~/FrontLayout/img/banner/banner-1.jpg" alt="">
                    </div>
                    <div class="banner__item__text">
                        <h2>Clothing Collections 2030</h2>
                        <a asp-controller="Shop" asp-action="Index">Shop now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="banner__item banner__item--middle">
                    <div class="banner__item__pic">
                        <img src="~/FrontLayout/img/banner/banner-2.jpg" alt="">
                    </div>
                    <div class="banner__item__text">
                        <h2>Accessories</h2>
                        <a asp-controller="Shop" asp-action="Index">Shop now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="banner__item banner__item--last">
                    <div class="banner__item__pic">
                        <img src="~/FrontLayout/img/banner/banner-3.jpg" alt="">
                    </div>
                    <div class="banner__item__text">
                        <h2>Shoes Spring 2030</h2>
                        <a asp-controller="Shop" asp-action="Index">Shop now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner Section End -->
<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        @if (tabs.Any())
        {
            <div class="row">
                <div class="col-lg-12">
                    <ul class="filter__controls">
                        @for (var t = 0; t < tabs.Count; t++)
                        {
                            <li class="@(t == 0 ? "active" : "")" data-filter=".@tabs[t].Key">@tabs[t].Label</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="row product__filter">
                @foreach (var tab in tabs)
                {
                    foreach (var p in tab.Items)
                    {
                        var primaryImage = p.ProductImages.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder).FirstOrDefault();
                        var onSale = p.DiscountedPrice.HasValue && p.DiscountedPrice < p.Price;
                        var isNew = p.CreatedAt >= DateTime.UtcNow.AddDays(-7);

                        <div class="col-lg-3 col-md-6 col-sm-6 mix @tab.Key">
                            <div class="product__item @(onSale ? "sale" : "")">
                                <div class="product__item__pic set-bg"
                                     data-setbg="@(primaryImage != null ? Url.Content($"~/uploads/products/{primaryImage.ImageUrl}") : Url.Content("~/FrontLayout/img/product/product-2.jpg"))">
                                    <a class="fh-pic-link" asp-controller="Shop" asp-action="ShopDetails" asp-route-id="@p.Id" aria-label="View @p.ProductName"></a>
                                    @if (onSale)
                                    {
                                        <span class="label">Sale</span>
                                    }
                                    else if (isNew)
                                    {
                                        <span class="label" style="background: #FF5E0E">New</span>
                                    }
                                </div>
                                <div class="product__item__text">
                                    <div class="fh-namecart">
                                        <a class="fh-name" asp-controller="Shop" asp-action="ShopDetails" asp-route-id="@p.Id">@(string.IsNullOrWhiteSpace(p.ProductName) ? "(No name)" : p.ProductName)</a>
                                        <div class="fh-cart">
                                            <a class="fh-cart-btn" asp-controller="Shop" asp-action="ShopDetails" asp-route-id="@p.Id">+ Select Options</a>
                                        </div>
                                    </div>

                                    <div class="rating">
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                        <i class="fa fa-star-o"></i>
                                    </div>

                                    @if (onSale)
                                    {
                                        <h5>
                                            Tk @p.DiscountedPrice!.Value.ToString("N0")
                                            <span style="text-decoration:line-through; opacity:.5; margin-left:6px;">Tk @p.Price.ToString("N0")</span>
                                        </h5>
                                    }
                                    else
                                    {
                                        <h5>Tk @p.Price.ToString("N0")</h5>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <p class="text-center">No products available yet.</p>
        }
    </div>
</section>
<!-- Product Section End -->
<!-- Categories Section Begin -->
<section class="categories spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="categories__text">
                    <h2>Clothings Hot <br /> <span>Shoe Collection</span> <br /> Accessories</h2>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="categories__hot__deal">
                    <img src="~/FrontLayout/img/product-sale.png" alt="">
                    <div class="hot__deal__sticker">
                        <span>Sale Of</span>
                        <h5>৳ 2700</h5>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 offset-lg-1">
                <div class="categories__deal__countdown">
                    <span>Deal Of The Week</span>
                    <h2>Multi-pocket Chest Bag Black</h2>
                    <div class="categories__deal__countdown__timer" id="countdown">
                        <div class="cd-item">
                            <span>3</span>
                            <p>Days</p>
                        </div>
                        <div class="cd-item">
                            <span>1</span>
                            <p>Hours</p>
                        </div>
                        <div class="cd-item">
                            <span>50</span>
                            <p>Minutes</p>
                        </div>
                        <div class="cd-item">
                            <span>18</span>
                            <p>Seconds</p>
                        </div>
                    </div>
                    <a asp-controller="Shop" asp-action="Index" class="primary-btn">Shop now</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Categories Section End -->
