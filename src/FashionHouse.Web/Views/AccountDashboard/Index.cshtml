@model FashionHouse.Web.Models.AccountDashboard.AccountDashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="acct-hero">
    <h1 class="acct-hero__title">Welcome back, Mr. @Model.FullName</h1>
    <p class="acct-hero__subtitle">Manage your orders, account, and preferences</p>
</div>

<div class="acct-actions">
    <a asp-controller="AccountDashboard" asp-action="EditProfile" class="acct-action">
        <i class="fa fa-user acct-action__icon"></i>
        <span class="acct-action__label">Edit profile</span>
    </a>
    <a asp-controller="AccountDashboard" asp-action="ChangePassword" class="acct-action">
        <i class="fa fa-lock acct-action__icon"></i>
        <span class="acct-action__label">Change password</span>
    </a>
    <a asp-controller="AccountDashboard" asp-action="Addresses" class="acct-action">
        <i class="fa fa-map-marker acct-action__icon"></i>
        <span class="acct-action__label">Manage addresses</span>
    </a>
    <a href="#" class="acct-action acct-action--disabled" onclick="return false;">
        <span class="acct-action__note">Coming soon</span>
        <i class="fa fa-truck acct-action__icon"></i>
        <span class="acct-action__label">Track order</span>
    </a>
</div>

<div class="acct-orders">
    <div class="acct-orders__header">Recent orders</div>
    <div class="acct-orders__empty">
        <p>Nothing here yet. Once you place an order, it'll show up in this space.</p>
        <a asp-controller="Shop" asp-action="Index" class="acct-orders__cta">Browse the collection</a>
    </div>
</div>