@model IList<FashionHouse.Domain.Entities.Address>
@{
    ViewData["Title"] = "My Addresses";
}

<div class="acct-hero">
    <h1 class="acct-hero__title">My Addresses</h1>
    <p class="acct-hero__subtitle">Manage your saved shipping addresses</p>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<div class="acct-orders">
    <div class="acct-orders__header d-flex justify-content-between align-items-center">
        <span>Saved addresses</span>
        <a asp-action="AddAddress" class="acct-orders__cta" style="text-decoration:none;">+ Add new address</a>
    </div>

    @if (!Model.Any())
    {
        <div class="acct-orders__empty">
            <p>You don't have any saved addresses yet.</p>
            <a asp-action="AddAddress" class="acct-orders__cta">Add your first address</a>
        </div>
    }
    else
    {
        <div style="padding: 1.5rem;">
            <div class="row g-3">
                @foreach (var address in Model)
                {
                    <div class="col-md-6">
                        <div class="card h-100 @(address.IsDefault ? "border-primary" : "")">
                            <div class="card-body">
                                @if (address.IsDefault)
                                {
                                    <span class="badge bg-primary mb-2">Default</span>
                                }
                                <h6 class="fw-bold mb-1">@address.FullName</h6>
                                <p class="mb-1">@address.Phone</p>
                                <p class="mb-1 text-secondary">@address.FullAddress, @address.District @address.PostalCode</p>

                                <div class="mt-3 d-flex gap-2">
                                    <a asp-action="EditAddress" asp-route-id="@address.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form asp-action="DeleteAddress" asp-route-id="@address.Id" method="post"
                                          onsubmit="return confirm('Delete this address?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>