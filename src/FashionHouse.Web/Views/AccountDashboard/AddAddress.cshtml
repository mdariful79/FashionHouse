@model FashionHouse.Web.Models.AccountDashboard.AddressFormModel
@{
    ViewData["Title"] = "Add Address";
}

<div class="acct-hero">
    <h1 class="acct-hero__title">Add a new address</h1>
</div>

<div class="acct-orders" style="max-width: 480px;">
    <div class="acct-orders__header">Address details</div>
    <div style="padding: 1.5rem;">
        <form asp-action="AddAddress" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullAddress" class="form-label"></label>
                <textarea asp-for="FullAddress" class="form-control" rows="3"></textarea>
                <span asp-validation-for="FullAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="District" class="form-label"></label>
                <input asp-for="District" class="form-control" />
                <span asp-validation-for="District" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" />
            </div>

            <div class="mb-4 form-check">
                <input asp-for="IsDefault" class="form-check-input" />
                <label asp-for="IsDefault" class="form-check-label"></label>
            </div>

            <button type="submit" class="acct-orders__cta" style="border:none;">Save address</button>
            <a asp-action="Addresses" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}