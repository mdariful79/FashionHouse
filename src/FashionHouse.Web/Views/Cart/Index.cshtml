@model FashionHouse.Domain.Entities.Cart
@{
    ViewData["Title"] = "Shopping Cart";
    var subTotal = Model.CartItems.Sum(x => (x.Product.DiscountedPrice ?? x.Product.Price) * x.Quantity);
}

<section class="shopping-cart spad">
    <div class="container">
        @if (!Model.CartItems.Any())
        {
            <div class="row">
                <div class="col-lg-12 text-center">
                    <p>Your cart is empty.</p>
                    <a asp-controller="Shop" asp-action="Index" class="primary-btn">Continue Shopping</a>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <div class="shopping__cart__table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items-body">
                                @foreach (var item in Model.CartItems)
                                {
                                    var unitPrice = item.Product.DiscountedPrice ?? item.Product.Price;
                                    var image = item.Product.ProductImages?.OrderByDescending(x => x.IsPrimary).FirstOrDefault()?.ImageUrl;
                                    <tr data-cart-item-id="@item.Id">
                                        <td class="cart__product__item">
                                            @if (!string.IsNullOrEmpty(image))
                                            {
                                                <img src="~/uploads/products/@image" alt="@item.Product.ProductName">
                                            }
                                            <div class="cart__product__item__title">
                                                <h6>@item.Product.ProductName</h6>
                                                <a href="#" class="remove-item" data-cart-item-id="@item.Id">Remove</a>
                                            </div>
                                        </td>
                                        <td class="cart__price">Tk @unitPrice.ToString("N0")</td>
                                        <td class="cart__quantity">
                                            <div class="quantity">
                                                <button class="qty-decrease" data-cart-item-id="@item.Id">-</button>
                                                <span class="qty-value">@item.Quantity</span>
                                                <button class="qty-increase" data-cart-item-id="@item.Id">+</button>
                                            </div>
                                        </td>
                                        <td class="cart__total line-total">Tk @((unitPrice * item.Quantity).ToString("N0"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="add__order__note">
                        <h6>Add Order Note</h6>
                        <textarea id="orderNote" placeholder="How can we help you?"></textarea>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart__discount">
                        <h6>Discount code</h6>
                        <form>
                            <input type="text" placeholder="Enter discount code">
                            <button type="submit">Apply</button>
                        </form>
                    </div>

                    <div class="cart__total__procced">
                        <h6>Subtotal <span id="cart-subtotal">Tk @subTotal.ToString("N0")</span></h6>
                        <a asp-controller="Checkout" asp-action="Index" class="primary-btn">Check out</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        var antiForgeryToken = '@Html.AntiForgeryToken()';

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function postJson(url, data) {
            return $.ajax({
                url: url,
                type: 'POST',
                data: $.extend({ __RequestVerificationToken: getToken() }, data)
            });
        }

        $(function () {
            $('.qty-increase, .qty-decrease').on('click', function () {
                var $row = $(this).closest('tr');
                var cartItemId = $(this).data('cart-item-id');
                var $qtyEl = $row.find('.qty-value');
                var qty = parseInt($qtyEl.text());
                qty = $(this).hasClass('qty-increase') ? qty + 1 : qty - 1;

                if (qty < 1) return;

                postJson('/Cart/UpdateQuantity', { cartItemId: cartItemId, quantity: qty })
                    .done(function (res) {
                        if (res.success) {
                            $qtyEl.text(qty);
                            $row.find('.line-total').text('Tk ' + Math.round(res.lineTotal));
                            $('#cart-subtotal').text('Tk ' + Math.round(res.subTotal));
                        } else {
                            alert(res.message || 'Could not update quantity.');
                        }
                    });
            });

            $('.remove-item').on('click', function (e) {
                e.preventDefault();
                var cartItemId = $(this).data('cart-item-id');
                var $row = $(this).closest('tr');

                postJson('/Cart/RemoveItem', { cartItemId: cartItemId })
                    .done(function (res) {
                        if (res.success) {
                            $row.fadeOut(200, function () {
                                $(this).remove();
                                $('#cart-subtotal').text('Tk ' + Math.round(res.subTotal));
                                if (res.itemCount === 0) location.reload();
                            });
                        }
                    });
            });
        });
    </script>
}