@model FashionHouse.Web.Models.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body text-center p-5">
                    @if (Model.IsSuccess)
                    {
                        <i class="bx bx-check-circle" style="font-size: 3rem; color: #71dd37;"></i>
                        <h4 class="mt-3">Email confirmed!</h4>
                        <p class="text-muted">
                            Your email <strong>@Model.Email</strong> has been confirmed. You can now log in to your account.
                        </p>
                        <a asp-action="Login" class="btn btn-primary mt-3">Go to Login</a>
                    }
                    else
                    {
                        <i class="bx bx-x-circle" style="font-size: 3rem; color: #ff3e1d;"></i>
                        <h4 class="mt-3">Confirmation failed</h4>
                        <p class="text-muted">
                            We couldn't confirm your email. The link may be invalid or expired.
                        </p>
                        <a asp-action="Register" class="btn btn-outline-primary mt-3">Register again</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>