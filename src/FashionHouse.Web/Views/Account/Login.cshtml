@using FashionHouse.Web.Models.Account
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Male Fashion</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/FrontLayout/css/font-awesome.min.css" />
    <style>
        :root {
            --cream: #F3F0EA;
            --paper: #FBFAF7;
            --ink: #0E0E0D;
            --line: rgba(14,14,13,.10);
            --muted: #7A7873;
            --red: #C1443B;
            --white: #FFFFFF;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            height: 100%;
            background: var(--cream);
            color: var(--ink);
            font-family: 'Jost', sans-serif;
        }

        .auth {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 100vh;
        }

        /* ---------- Left: futuristic brand panel ---------- */
        .auth__brand {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3.2rem;
            background: var(--ink);
            color: var(--paper);
        }

        .dotgrid {
            position: absolute;
            top: -40px;
            right: -40px;
            width: 380px;
            height: 380px;
            background-image: radial-gradient(circle, rgba(243,240,234,.16) 1.4px, transparent 1.4px);
            background-size: 22px 22px;
            opacity: .8;
            z-index: 0;
            mask-image: radial-gradient(circle at 70% 30%, rgba(0,0,0,1) 0%, transparent 72%);
        }

        .auth__brand::after {
            content: "";
            position: absolute;
            left: -160px;
            bottom: -160px;
            width: 460px;
            height: 460px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(193,68,59,.22) 0%, transparent 70%);
            filter: blur(2px);
            animation: pulse 8s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: .5; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.08); }
        }

        .scanline {
            position: absolute;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(193,68,59,.55), transparent);
            animation: scan 5.5s linear infinite;
            z-index: 1;
        }

        @@keyframes scan {
            0% { top: 8%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 92%; opacity: 0; }
        }

        .auth__mark {
            position: relative;
            z-index: 2;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: .01em;
        }

        .auth__mark a { color: var(--paper); text-decoration: none; }
        .auth__mark .dot { color: var(--red); }

        .auth__statement {
            position: relative;
            z-index: 2;
            max-width: 440px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--red);
            margin-bottom: 1rem;
        }

        .eyebrow::before {
            content: "";
            width: 26px;
            height: 1px;
            background: var(--red);
        }

        .auth__statement h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 500;
            font-size: 2.7rem;
            line-height: 1.12;
            margin: 0 0 1.1rem;
            letter-spacing: -.01em;
        }

        .auth__statement p {
            color: rgba(243,240,234,.62);
            font-size: 1rem;
            line-height: 1.7;
            margin: 0;
            font-weight: 300;
        }

        .auth__meta {
            position: relative;
            z-index: 2;
            display: flex;
            gap: 2.2rem;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(243,240,234,.4);
        }

        .auth__meta span b { color: var(--paper); font-weight: 600; }

        /* ---------- Right: form panel ---------- */
        .auth__panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: var(--cream);
        }

        .auth__card {
            width: 100%;
            max-width: 400px;
        }

        .auth__card .kicker {
            font-family: 'Space Grotesk', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--red);
            margin: 0 0 .6rem;
        }

        .auth__card h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.9rem;
            font-weight: 500;
            margin: 0 0 .5rem;
            letter-spacing: -.01em;
        }

        .auth__card .sub {
            color: var(--muted);
            font-size: .92rem;
            font-weight: 300;
            margin: 0 0 2rem;
        }

        .field { margin-bottom: 1.3rem; position: relative; }

        .field label {
            display: block;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--ink);
            margin-bottom: .55rem;
        }

        .field input[type="email"],
        .field input[type="password"] {
            width: 100%;
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: 0;
            padding: .85rem 1rem;
            color: var(--ink);
            font-size: .95rem;
            font-family: 'Jost', sans-serif;
            outline: none;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .field input:focus {
            border-color: var(--red);
            box-shadow: 0 0 0 3px rgba(193,68,59,.08);
        }

        .field input::placeholder { color: #B4B1AA; }

        .text-danger { color: var(--red); font-size: .8rem; }

        .remember {
            display: flex;
            align-items: center;
            gap: .55rem;
            margin-bottom: 1.8rem;
        }

        .remember label {
            color: var(--muted);
            font-size: .85rem;
            margin: 0;
            font-weight: 300;
        }

        .remember input { accent-color: var(--red); }

        .btn-auth {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            background: var(--ink);
            color: var(--paper);
            border: none;
            border-radius: 0;
            padding: .95rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: .8rem;
            letter-spacing: .14em;
            text-transform: uppercase;
            cursor: pointer;
            transition: background .18s ease, letter-spacing .18s ease;
        }

        .btn-auth:hover {
            background: var(--red);
            letter-spacing: .18em;
        }

        .btn-auth .fa { font-size: .8rem; }

        .auth__links {
            display: flex;
            justify-content: space-between;
            margin-top: 1.7rem;
            font-size: .85rem;
        }

        .auth__links a {
            color: var(--muted);
            text-decoration: none;
            font-weight: 300;
            border-bottom: 1px solid transparent;
            transition: color .15s ease, border-color .15s ease;
        }

        .auth__links a:hover {
            color: var(--red);
            border-color: var(--red);
        }

        @@media (max-width: 900px) {
            .auth { grid-template-columns: 1fr; }
            .auth__brand { display: none; }
            .auth__panel { padding: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="auth">
        <div class="auth__brand">
            <div class="dotgrid"></div>
            <div class="scanline"></div>

            <div class="auth__mark">
                <a asp-area="" asp-controller="Home" asp-action="Index">Male Fashion<span class="dot">.</span></a>
            </div>

            <div class="auth__statement">
                <div class="eyebrow">Member Access</div>
                <h1>Step into the Summer&nbsp;&mdash;&nbsp;Winter @DateTime.Now.Year wardrobe.</h1>
                <p>Sign in to pick up your saved pieces, track orders, and move straight to checkout.</p>
            </div>

            <div class="auth__meta">
                <span><b>04</b> Collections</span>
                <span><b>12k+</b> Members</span>
                <span><b>24/7</b> Support</span>
            </div>
        </div>

        <div class="auth__panel">
            <div class="auth__card">
                <p class="kicker">Welcome Back</p>
                <h2>Log in</h2>
                <p class="sub">Use your account to continue</p>

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" autocomplete="current-password" aria-required="true" placeholder="Your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="remember">
                        <input asp-for="RememberMe" />
                        <label asp-for="RememberMe">@Html.DisplayNameFor(m => m.RememberMe)</label>
                    </div>

                    <button type="submit" class="btn-auth">
                        Log in <i class="fa fa-arrow-right"></i>
                    </button>

                    <div class="auth__links">
                        <a asp-area="" asp-controller="Account" asp-action="Register">Create an account</a>
                        <a asp-area="" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
