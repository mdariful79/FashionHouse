@using FashionHouse.Web.Models.Account
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Male Fashion</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/FrontLayout/css/font-awesome.min.css" />
    <style>
        :root {
            --cream: #F3F0EA;
            --paper: #FBFAF7;
            --ink: #0E0E0D;
            --line: rgba(14,14,13,.10);
            --muted: #7A7873;
            --red: #C1443B;
            --white: #FFFFFF;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            min-height: 100%;
            background: var(--cream);
            color: var(--ink);
            font-family: 'Jost', sans-serif;
        }

        .auth {
            display: grid;
            grid-template-columns: .95fr 1.05fr;
            min-height: 100vh;
        }

        /* ---------- Left: futuristic brand panel ---------- */
        .auth__brand {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3.2rem;
            background: var(--ink);
            color: var(--paper);
        }

        .dotgrid {
            position: absolute;
            top: -40px;
            right: -40px;
            width: 380px;
            height: 380px;
            background-image: radial-gradient(circle, rgba(243,240,234,.16) 1.4px, transparent 1.4px);
            background-size: 22px 22px;
            opacity: .8;
            z-index: 0;
            mask-image: radial-gradient(circle at 70% 30%, rgba(0,0,0,1) 0%, transparent 72%);
        }

        .auth__brand::after {
            content: "";
            position: absolute;
            left: -160px;
            bottom: -160px;
            width: 460px;
            height: 460px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(193,68,59,.22) 0%, transparent 70%);
            filter: blur(2px);
            animation: pulse 8s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: .5; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.08); }
        }

        .scanline {
            position: absolute;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(193,68,59,.55), transparent);
            animation: scan 5.5s linear infinite;
            z-index: 1;
        }

        @@keyframes scan {
            0% { top: 8%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 92%; opacity: 0; }
        }

        .auth__mark {
            position: relative;
            z-index: 2;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: 1.3rem;
        }

        .auth__mark a { color: var(--paper); text-decoration: none; }
        .auth__mark .dot { color: var(--red); }

        .auth__statement {
            position: relative;
            z-index: 2;
            max-width: 420px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--red);
            margin-bottom: 1rem;
        }

        .eyebrow::before {
            content: "";
            width: 26px;
            height: 1px;
            background: var(--red);
        }

        .auth__statement h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 500;
            font-size: 2.5rem;
            line-height: 1.14;
            margin: 0 0 1.1rem;
            letter-spacing: -.01em;
        }

        .auth__statement p {
            color: rgba(243,240,234,.62);
            font-size: 1rem;
            line-height: 1.7;
            margin: 0;
            font-weight: 300;
        }

        .perks {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: .85rem;
            margin-top: 2.2rem;
        }

        .perks li, .perks div {
            display: flex;
            align-items: center;
            gap: .7rem;
            font-size: .87rem;
            color: rgba(243,240,234,.75);
            font-weight: 300;
            list-style: none;
        }

        .perks .fa {
            color: var(--red);
            font-size: .8rem;
            width: 18px;
        }

        .auth__meta {
            position: relative;
            z-index: 2;
            display: flex;
            gap: 2.2rem;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(243,240,234,.4);
        }

        .auth__meta span b { color: var(--paper); font-weight: 600; }

        /* ---------- Right: form panel ---------- */
        .auth__panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 2rem;
            background: var(--cream);
        }

        .auth__card {
            width: 100%;
            max-width: 460px;
        }

        .auth__card .kicker {
            font-family: 'Space Grotesk', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--red);
            margin: 0 0 .6rem;
        }

        .auth__card h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.9rem;
            font-weight: 500;
            margin: 0 0 .5rem;
            letter-spacing: -.01em;
        }

        .auth__card .sub {
            color: var(--muted);
            font-size: .92rem;
            font-weight: 300;
            margin: 0 0 1.9rem;
        }

        .row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .field { margin-bottom: 1.1rem; }

        .field label {
            display: block;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--ink);
            margin-bottom: .55rem;
        }

        .field input {
            width: 100%;
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: 0;
            padding: .8rem 1rem;
            color: var(--ink);
            font-size: .95rem;
            font-family: 'Jost', sans-serif;
            outline: none;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .field input:focus {
            border-color: var(--red);
            box-shadow: 0 0 0 3px rgba(193,68,59,.08);
        }

        .field input::placeholder { color: #B4B1AA; }

        .text-danger { color: var(--red); font-size: .8rem; }

        .btn-auth {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            background: var(--ink);
            color: var(--paper);
            border: none;
            border-radius: 0;
            padding: .95rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: .8rem;
            letter-spacing: .14em;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: .3rem;
            transition: background .18s ease, letter-spacing .18s ease;
        }

        .btn-auth:hover {
            background: var(--red);
            letter-spacing: .18em;
        }

        .divider {
            display: flex;
            align-items: center;
            gap: .9rem;
            margin: 1.9rem 0 1.4rem;
        }

        .divider::before, .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--line);
        }

        .divider span {
            font-family: 'Space Grotesk', sans-serif;
            font-size: .68rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
            white-space: nowrap;
        }

        .external-note {
            font-size: .85rem;
            color: var(--muted);
            font-weight: 300;
            line-height: 1.6;
        }

        .external-note a { color: var(--red); }

        .btn-external {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            background: var(--paper);
            border: 1px solid var(--line);
            color: var(--ink);
            padding: .7rem 1.1rem;
            font-family: 'Space Grotesk', sans-serif;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            cursor: pointer;
            margin: 0 .5rem .5rem 0;
            transition: border-color .15s ease, color .15s ease;
        }

        .btn-external:hover {
            border-color: var(--red);
            color: var(--red);
        }

        .auth__links {
            margin-top: 1.6rem;
            font-size: .85rem;
            color: var(--muted);
            font-weight: 300;
        }

        .auth__links a {
            color: var(--ink);
            text-decoration: none;
            border-bottom: 1px solid var(--red);
            font-weight: 500;
        }

        .auth__links a:hover { color: var(--red); }

        @@media (max-width: 900px) {
            .auth { grid-template-columns: 1fr; }
            .auth__brand { display: none; }
            .auth__panel { padding: 1.5rem; }
            .row-2 { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="auth">
        <div class="auth__brand">
            <div class="dotgrid"></div>
            <div class="scanline"></div>

            <div class="auth__mark">
                <a asp-area="" asp-controller="Home" asp-action="Index">Male Fashion<span class="dot">.</span></a>
            </div>

            <div class="auth__statement">
                <div class="eyebrow">Join The House</div>
                <h1>Create your profile, wear the future.</h1>
                <p>Register to unlock saved pieces, order tracking, and early access to the Summer &mdash; Winter @DateTime.Now.Year drop.</p>

                <div class="perks">
                    <div><i class="fa fa-check"></i> Early access to new collections</div>
                    <div><i class="fa fa-check"></i> Faster checkout, saved details</div>
                    <div><i class="fa fa-check"></i> Order tracking in one place</div>
                </div>
            </div>

            <div class="auth__meta">
                <span><b>04</b> Collections</span>
                <span><b>12k+</b> Members</span>
                <span><b>24/7</b> Support</span>
            </div>
        </div>

        <div class="auth__panel">
            <div class="auth__card">
                <p class="kicker">Get Started</p>
                <h2>Create an account</h2>
                <p class="sub">It only takes a minute</p>

                <form id="registerForm" asp-area="" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row-2">
                        <div class="field">
                            <label asp-for="FirstName">First Name</label>
                            <input asp-for="FirstName" autocomplete="given-name" aria-required="true" placeholder="First Name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label asp-for="LastName">Last Name</label>
                            <input asp-for="LastName" autocomplete="family-name" aria-required="true" placeholder="Last Name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                <div class="field">
    <label asp-for="DateOfBirth">Date of Birth</label>
    <input asp-for="DateOfBirth" type="date" autocomplete="bday" aria-required="true" asp-format="{0:yyyy-MM-dd}" />
    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
</div>

                    <div class="row-2">
                        <div class="field">
                            <label asp-for="Password">Password</label>
                            <input asp-for="Password" autocomplete="new-password" aria-required="true" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <input asp-for="ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn-auth">
                        Create Account <i class="fa fa-arrow-right"></i>
                    </button>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="divider"><span>Or continue with</span></div>
                    <form id="external-account" asp-action="ExternalLogin" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                            }
                        </div>
                    </form>
                }

                <p class="auth__links">
                    Already have an account?
                    <a asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                </p>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
