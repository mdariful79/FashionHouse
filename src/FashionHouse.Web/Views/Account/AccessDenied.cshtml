@{
    ViewData["Title"] = "Access denied";
    Layout = null;
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Male Fashion</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/FrontLayout/css/font-awesome.min.css" />
    <style>
            :root {
                --cream: #F3F0EA;
                --paper: #FBFAF7;
                --ink: #0E0E0D;
                --line: rgba(14,14,13,.10);
                --muted: #7A7873;
                --red: #C1443B;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                min-height: 100%;
                background: var(--ink);
                color: var(--paper);
                font-family: 'Jost', sans-serif;
            }

            .denied {
                position: relative;
                overflow: hidden;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem;
                background: var(--ink);
            }

            /* ---------- Decorative background ---------- */
            .dotgrid {
                position: absolute;
                top: -40px;
                right: -40px;
                width: 420px;
                height: 420px;
                background-image: radial-gradient(circle, rgba(243,240,234,.16) 1.4px, transparent 1.4px);
                background-size: 22px 22px;
                opacity: .8;
                mask-image: radial-gradient(circle at 70% 30%, rgba(0,0,0,1) 0%, transparent 72%);
                -webkit-mask-image: radial-gradient(circle at 70% 30%, rgba(0,0,0,1) 0%, transparent 72%);
            }

            .denied::after {
                content: "";
                position: absolute;
                left: -180px;
                bottom: -180px;
                width: 520px;
                height: 520px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(193,68,59,.24) 0%, transparent 70%);
                animation: pulse 8s ease-in-out infinite;
                pointer-events: none;
            }

            @@keyframes pulse {
                0%, 100% {
                    opacity: .5;
                    transform: scale(1);
                }

                50% {
                    opacity: 1;
                    transform: scale(1.08);
                }
            }

            .scanline {
                position: absolute;
                left: 0;
                width: 100%;
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(193,68,59,.55), transparent);
                animation: scan 5.5s linear infinite;
            }

            @@keyframes scan {
                0% {
                    top: 8%;
                    opacity: 0;
                }

                10% {
                    opacity: 1;
                }

                90% {
                    opacity: 1;
                }

                100% {
                    top: 92%;
                    opacity: 0;
                }
            }

            /* ---------- Brand mark ---------- */
            .mark {
                position: absolute;
                top: 2.4rem;
                left: 3rem;
                z-index: 2;
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 600;
                font-size: 1.3rem;
            }

                .mark a {
                    color: var(--paper);
                    text-decoration: none;
                }

                .mark .dot {
                    color: var(--red);
                }

            /* ---------- Content ---------- */
            .denied__content {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 560px;
                text-align: left;
            }

            .code {
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 700;
                font-size: clamp(5.5rem, 18vw, 9rem);
                line-height: 1;
                letter-spacing: -.04em;
                margin: 0 0 .4rem;
                color: transparent;
                -webkit-text-stroke: 1.5px rgba(243,240,234,.55);
            }

                .code span {
                    color: var(--red);
                    -webkit-text-stroke: 0;
                }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: .5rem;
                font-family: 'Space Grotesk', sans-serif;
                font-size: .72rem;
                font-weight: 600;
                letter-spacing: .18em;
                text-transform: uppercase;
                color: var(--red);
                margin-bottom: 1rem;
            }

                .eyebrow::before {
                    content: "";
                    width: 26px;
                    height: 1px;
                    background: var(--red);
                }

            h1 {
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 500;
                font-size: 2.3rem;
                line-height: 1.15;
                letter-spacing: -.01em;
                margin: 0 0 1rem;
            }

            .lead {
                color: rgba(243,240,234,.62);
                font-size: 1rem;
                line-height: 1.7;
                font-weight: 300;
                margin: 0 0 1.6rem;
                max-width: 460px;
            }

            .who {
                display: inline-flex;
                align-items: center;
                gap: .6rem;
                font-size: .85rem;
                font-weight: 300;
                color: rgba(243,240,234,.75);
                border: 1px solid rgba(243,240,234,.14);
                padding: .55rem .9rem;
                margin-bottom: 2rem;
            }

                .who .fa {
                    color: var(--red);
                }

                .who b {
                    font-weight: 500;
                    color: var(--paper);
                }

            .actions {
                display: flex;
                flex-wrap: wrap;
                gap: .8rem;
                margin-bottom: 2rem;
            }

            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: .6rem;
                padding: .95rem 1.5rem;
                border: 1px solid transparent;
                border-radius: 0;
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 600;
                font-size: .78rem;
                letter-spacing: .14em;
                text-transform: uppercase;
                text-decoration: none;
                cursor: pointer;
                transition: background .18s ease, color .18s ease, border-color .18s ease, letter-spacing .18s ease;
            }

                .btn .fa {
                    font-size: .8rem;
                }

            .btn--primary {
                background: var(--paper);
                color: var(--ink);
            }

                .btn--primary:hover {
                    background: var(--red);
                    color: var(--paper);
                    letter-spacing: .18em;
                }

            .btn--ghost {
                background: transparent;
                color: var(--paper);
                border-color: rgba(243,240,234,.25);
            }

                .btn--ghost:hover {
                    border-color: var(--red);
                    color: var(--red);
                }

            .help {
                font-size: .85rem;
                color: rgba(243,240,234,.45);
                font-weight: 300;
            }

                .help a {
                    color: rgba(243,240,234,.75);
                    text-decoration: none;
                    border-bottom: 1px solid var(--red);
                }

                    .help a:hover {
                        color: var(--red);
                    }

            .signout-form {
                display: inline;
                margin: 0;
            }

            @@media (max-width: 600px) {
                .mark {
                    left: 1.5rem;
                    top: 1.6rem;
                }

                h1 {
                    font-size: 1.8rem;
                }

                .actions .btn, .signout-form, .signout-form .btn {
                    width: 100%;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .scanline, .denied::after {
                    animation: none;
                }
            }
    </style>
</head>
<body>
    <main class="denied">
        <div class="dotgrid"></div>
        <div class="scanline"></div>

        <div class="mark">
            <a asp-area="" asp-controller="Home" asp-action="Index">Fashion House<span class="dot">.</span></a>
        </div>

        <section class="denied__content">
            <div class="code">4<span>0</span>3</div>

            <div class="eyebrow">Restricted Area</div>
            <h1>You don't have access to this page.</h1>
            <p class="lead">
                Your account doesn't have the permissions needed to view this resource.
                If you think this is a mistake, try signing in with a different account or contact support.
            </p>

            @if (isSignedIn)
            {
                <div class="who">
                    <i class="fa fa-user-o"></i>
                    <span>Signed in as <b>@User.Identity!.Name</b></span>
                </div>
            }

            <div class="actions">
                <a class="btn btn--primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa fa-home"></i> Back to home
                </a>

                <button type="button" class="btn btn--ghost" onclick="history.length > 1 ? history.back() : (location.href='@Url.Action("Index", "Home", new { area = "" })')">
                    <i class="fa fa-arrow-left"></i> Go back
                </button>

                @if (isSignedIn)
                {
                    <form class="signout-form" asp-area="" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Login", "Account", new { area = "" })" method="post">
                        <button type="submit" class="btn btn--ghost">
                            <i class="fa fa-sign-out"></i> Switch account
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn--ghost" asp-area="" asp-controller="Account" asp-action="Login">
                        <i class="fa fa-sign-in"></i> Log in
                    </a>
                }
            </div>

            <p class="help">Need help? <a href="mailto:info@fashionhouse.com">Contact support</a></p>
        </section>
    </main>
</body>
</html>
