@{
    ViewData["Title"] = "Check Your Email";
    var email = ViewData["Email"] as string;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body text-center p-5">
                    <i class="bx bx-envelope" style="font-size: 3rem; color: #696cff;"></i>
                    <h4 class="mt-3">Check your inbox</h4>
                    <p class="text-muted">
                        We've sent a confirmation link to <strong>@email</strong>.
                        Please click the link in that email to activate your account.
                    </p>
                    <p class="text-muted small">
                        Didn't get the email? Check your spam folder, or
                        <a asp-action="Register">try registering again</a>.
                    </p>
                    <a href="@returnUrl" class="btn btn-primary mt-3">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>